{
  "extends": "../polyfill-connectors/tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": false,
    "outDir": "dist",
    "removeComments": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "..",
    "sourceMap": false,
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": [
    "bin/**/*.ts",
    "src/**/*.ts",
    // Bundled filesystem-class connectors compiled into the tarball so the
    // generic runtime can spawn them. This list is the collector's PACKAGING
    // manifest (what ships), kept in lockstep with the connector-owned
    // `LOCAL_COLLECTOR_DEFINITIONS` registry — a test
    // (`bundled connector dist entries match the injected definitions`)
    // asserts the two never drift. The runtime itself names no connector.
    "../polyfill-connectors/connectors/claude_code/**/*.ts",
    "../polyfill-connectors/connectors/codex/**/*.ts",
    "../polyfill-connectors/connectors/imessage/**/*.ts",
    "../polyfill-connectors/connectors/google_takeout/**/*.ts",
    "../polyfill-connectors/connectors/apple_photos/**/*.ts",
    "../polyfill-connectors/connectors/google_messages/**/*.ts",
    "../polyfill-connectors/src/browser-handoff.ts",
    "../polyfill-connectors/src/connector-runtime.ts",
    "../polyfill-connectors/src/fixture-capture.ts",
    "../polyfill-connectors/src/local-source-inventory.ts",
    "../polyfill-connectors/src/schema-registry.ts",
    "../polyfill-connectors/src/shutdown-hook.ts",
    "../polyfill-connectors/src/streaming-target-registration.ts",
    // @pdpp/collector-runtime's local-device-client.ts has always imported
    // canonicalTerminalRunCommitEnvelope from @pdpp/reference-contract/common
    // as a real runtime dependency (flagged, not introduced, by engine-split
    // slice 1's report §7 as a pre-existing gap: this package never vendored
    // or declared @pdpp/reference-contract). common/ is self-contained (zero
    // imports outside itself) and small, so it is vendored here directly —
    // the same pattern already used for the polyfill-connectors entries
    // above — rather than adding a new package-wide build to
    // reference-contract for one function. Transitional: reference-contract
    // is the neutral, publishable contract package; once it ships, this
    // becomes an ordinary published dependency instead of a vendored copy.
    "../reference-contract/src/common/**/*.ts"
    // @pdpp/collector-runtime and @pdpp/connector-protocol are NOT vendored
    // here (engine-split slice 2). Both are ordinary workspace dependencies
    // (see package.json) with their own build producing dist/ + .d.ts; this
    // package imports their compiled output like any other npm dependency,
    // not their .ts source. See scripts/postbuild.ts's copyBuiltPackageDist
    // for how their dist/ trees land inside this package's own dist/.
  ],
  "exclude": [
    "**/*.test.ts",
    "../polyfill-connectors/**/*.test.ts",
    "**/__fixtures__/**",
    "../polyfill-connectors/fixtures/**",
    // Test-support fixture builder, not a connector runtime dependency — it
    // imports better-sqlite3 (a native compiled module this published
    // package must never bundle; see connectors/imessage/index.ts's module
    // doc and validate-package.ts's forbidden-pattern list).
    "../polyfill-connectors/connectors/imessage/fixtures.ts"
  ]
}
