{
  "name": "@pdpp/local-collector",
  "version": "0.0.0",
  "private": false,
  "description": "Publishable local collector runtime for PDPP: filesystem-class connectors (Claude Code, Codex) plus the device-exporter ingest client.",
  "keywords": [
    "pdpp",
    "personal-data",
    "collector",
    "data-portability"
  ],
  "homepage": "https://github.com/PDP-Connect/pdpp#readme",
  "bugs": {
    "url": "https://github.com/PDP-Connect/pdpp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PDP-Connect/pdpp.git",
    "directory": "packages/local-collector"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/local-collector/src/runner.d.ts",
      "import": "./dist/local-collector/src/runner.js"
    },
    "./runner": {
      "types": "./dist/local-collector/src/runner.d.ts",
      "import": "./dist/local-collector/src/runner.js"
    },
    "./errors": {
      "types": "./dist/local-collector/src/errors.d.ts",
      "import": "./dist/local-collector/src/errors.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/local-collector/src/runner.js",
  "types": "./dist/local-collector/src/runner.d.ts",
  "bin": {
    "pdpp-local-collector": "dist/local-collector/bin/pdpp-local-collector.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm --filter @pdpp/collector-runtime --filter @pdpp/connector-protocol run build && rm -rf dist && tsc -p tsconfig.build.json && tsx scripts/postbuild.ts",
    "prepack": "pnpm build",
    "pack-install-run": "node --import tsx scripts/pack-install-run.ts",
    "prepare": "pnpm build",
    "test": "node --import tsx ../../scripts/test-scratch/run-command.ts -- tsx scripts/run-tests.ts",
    "validate:package": "tsx scripts/validate-package.ts",
    "verify": "pnpm test && pnpm validate:package"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@pdpp/collector-runtime": "workspace:*",
    "@pdpp/connector-protocol": "workspace:*",
    "conventional-changelog-conventionalcommits": "^10.2.1"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false,
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  }
}
