{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": ["ultracite/biome/core", "ultracite/biome/type-aware"],
  "formatter": {
    "lineWidth": 120
  },
  "files": {
    "ignoreUnknown": true,
    // The shared tracked-source contract includes authored JS/TS/config files
    // and force-excludes dependency/build output, raw data, and generated or
    // report artifacts.
    "includes": [
      "!!**/node_modules",
      "!!**/.git",
      "!!**/dist",
      "!!**/build",
      "!!**/out",
      "!!**/.next",
      "!!**/.source",
      "!!**/coverage",
      "!!**/reports",
      "!!**/report",
      "!!**/*.snap",
      "!!**/*.har",
      "!!**/*.jsonl",
      "!!**/docs/generated",
      "!!**/next-env.d.ts",
      "!!**/report.*.json"
    ]
  }
}
