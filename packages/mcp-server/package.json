{
  "name": "@pdpp/mcp-server",
  "version": "0.0.0",
  "description": "Local stdio MCP adapter for grant-scoped PDPP reads and event-subscription management.",
  "type": "module",
  "bin": {
    "pdpp-mcp-server": "./dist/bin/pdpp-mcp-server.js"
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./server": "./dist/src/server.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "pnpm build",
    "prepack": "pnpm build",
    "test": "node ../../scripts/test-accounting/authority.mjs --run --suite mcp-server --profile default",
    "test:read-surface": "node ../../scripts/test-accounting/authority.mjs --run --suite mcp-server --profile default",
    "validate:package": "pnpm build && node scripts/package-contract.mjs",
    "verify:artifact": "pnpm build && node scripts/pack-install-run.mjs",
    "verify": "pnpm test && pnpm validate:package",
    "pack:dry-run": "pnpm build && npm pack --dry-run --ignore-scripts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pdpp/cli": ">=0.18.11 <1.0.0",
    "@pdpp/read-core": ">=0.18.11 <1.0.0",
    "zod": "^3.25.76"
  },
  "keywords": [
    "pdpp",
    "personal-data",
    "mcp",
    "model-context-protocol"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PDP-Connect/pdpp.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/PDP-Connect/pdpp/issues"
  },
  "homepage": "https://github.com/PDP-Connect/pdpp#readme",
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false,
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  }
}
