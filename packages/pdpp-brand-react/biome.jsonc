{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": ["ultracite/biome/core", "ultracite/biome/type-aware"],
  "formatter": {
    "lineWidth": 120
  },
  // Object insertion order is observable through Object.keys, for-in, and
  // JSON.stringify. Keep authored query/serialization order; this disables
  // only Biome's source assist, not a linter rule.
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "off"
      }
    }
  },
  "files": {
    "ignoreUnknown": true,
    // The tracked-source contract includes authored JS/TS/config files and
    // force-excludes dependency/build output, raw data, and generated or
    // report artifacts.
    "includes": [
      "!!**/node_modules",
      "!!**/.git",
      "!!**/dist",
      "!!**/build",
      "!!**/out",
      "!!**/.next",
      "!!**/.source",
      "!!**/coverage",
      "!!**/reports",
      "!!**/report",
      "!!**/*.snap",
      "!!**/*.har",
      "!!**/*.jsonl",
      "!!**/docs/generated",
      "!!**/next-env.d.ts",
      "!!**/report.*.json"
    ]
  },
  "overrides": [
    {
      // Upstream Biome resolver false-positive waiver — NOT a doctrine change.
      //
      // Biome's noUnresolvedImports misreports declared deps with an `exports`
      // field (class-variance-authority, and the same clsx / tailwind-merge
      // class of packages) while tsc (moduleResolution: "bundler"), pnpm's
      // Node resolver, and the consuming Next bundler all resolve them.
      //
      // Tracked upstream:
      //   - https://github.com/biomejs/biome/issues/9143
      //   - https://github.com/biomejs/biome/issues/6464
      //
      // Exit condition: remove once Biome resolves package `exports` cleanly.
      // Re-run `pnpm --dir packages/pdpp-brand-react check`; if the rule stays
      // clean, drop this entire overrides block entry.
      //
      // Scoped to src/** only. NOTHING ELSE IS RELAXED.
      "includes": ["src/**/*.ts", "src/**/*.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off"
          }
        }
      }
    },
    {
      // Ink Carbon design-system barrel — a single index.ts that re-exports
      // every component in the library. This is intentional: the barrel is the
      // public API surface of a bounded component library (the `.` export of
      // @pdpp/brand-react), not the anti-pattern noBarrelFile guards against
      // (re-exporting an entire feature directory). Tree-shaking and the
      // Next.js bundler handle this correctly.
      "includes": ["src/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    }
  ]
}
