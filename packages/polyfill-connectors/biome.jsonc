{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": ["ultracite/biome/core", "ultracite/biome/type-aware"],
  "linter": {
    "rules": {
      "correctness": {
        // Tool-resolution gap, not a real import defect: `tsc --noEmit`
        // resolves every one of these specifiers cleanly (verified
        // 2026-07). Two documented causes account for all 33 baseline
        // findings:
        //  (1) Biome's resolver mis-handles certain package.json
        //      `exports`/`main` shapes ("found directory without index")
        //      for otherwise-valid dependencies — upstream tracking:
        //      https://github.com/biomejs/biome/issues/9143. Affects
        //      imapflow, linkedom, better-sqlite3, dotenv, ofx-js,
        //      pdf-parse, p-queue, @streamparser/json here, each verified
        //      to have a valid main/exports field.
        //  (2) `node:sqlite` (stable Node core module since Node 22.5) is
        //      not yet in Biome's built-in-module allowlist.
        // Re-enable and re-audit when Biome ships a fix for either gap.
        "noUnresolvedImports": "off"
      },
      "suspicious": {
        // Package-wide policy, not a general escape hatch. Baseline: 165
        // findings. Individually audited every one (2026-07): 5 were
        // genuine dead code and were fixed in place (bin/register-all.ts's
        // captured-`server` closure narrowing, connectors/google_maps_data_
        // portability/api.ts's `value?.trim()` on a required `string` param,
        // connectors/ical/parsers.ts's `event.attendees ?? []` on a
        // non-optional array field, connectors/codex/parsers.ts's
        // `payload?.content` on a required param, and src/runtime-
        // capabilities.ts's `decl?.required` on a non-optional tuple
        // element). The remaining 143 are ALL Biome 2.5.5 false positives,
        // reproduced with a minimal, standalone case (a `readonly x: T |
        // null` class field assigned a genuinely-nullable value in the
        // constructor still gets `this.x?.prop ?? fallback` flagged as
        // "left-hand side is guaranteed non-nullish" — see
        // scripts/check-no-unnecessary-conditions-expiry.ts for the exact
        // repro). The same root defect also fires on Record/array indexed
        // access under noUncheckedIndexedAccess (`headers["content-type"]`,
        // `record[key]`) and on optional params/fields the rule fails to
        // narrow through a closure or a raw-JSON/dynamic-import type
        // assertion. `tsc --noEmit` — which every other check in this
        // package trusts — agrees these values are genuinely nullable;
        // Biome's own docs mark noUnnecessaryConditions "work in progress".
        // Expiry: `pnpm run check:noUnnecessaryConditions-expiry` (wired
        // into `pnpm verify`) re-runs the minimal repro against whatever
        // Biome version is installed and fails loudly the moment Biome
        // stops reproducing it — that is the re-enable signal. Do not
        // remove this override without that script passing first, and do
        // not widen it to any other rule.
        "noUnnecessaryConditions": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        // Object key order is part of the captured fixture and subprocess
        // protocol contract (for example JSON.stringify output). Biome
        // documents that this assist changes that observable order.
        "useSortedKeys": "off"
      }
    }
  },
  "formatter": {
    "lineWidth": 120
  },
  "files": {
    "ignoreUnknown": true,
    // The tracked-source contract includes authored JS/TS/config files,
    // including tests. Raw fixture captures and data extensions are excluded;
    // executable fixture code remains selected.
    "includes": [
      "!!**/node_modules",
      "!!**/.git",
      "!!**/dist",
      "!!**/build",
      "!!**/out",
      "!!**/.next",
      "!!**/.source",
      "!!**/coverage",
      "!!**/reports",
      "!!**/report",
      "!!**/*.snap",
      "!!**/*.har",
      "!!**/*.jsonl",
      "!!fixtures/**/*.json",
      "!!fixtures/**/*.html",
      "!!fixtures/**/*.csv",
      "!!fixtures/**/*.md",
      "!!fixtures/**/*.log",
      "!!fixtures/**/*.dat",
      "!!connectors/**/__fixtures__/**/*.html",
      "!!connectors/**/__fixtures__/**/*.json",
      "!!connectors/**/__fixtures__/**/*.csv",
      // Provider-exported Twitter archive captures use .js despite being raw
      // data. Authored executable fixture helpers remain selected.
      "!!connectors/twitter_archive/__fixtures__/archive-files/**/*.js",
      "!!**/next-env.d.ts",
      "!!**/report.*.json"
    ]
  },
  "overrides": [
    {
      // Cognitive-complexity error gate for production source (src/, bin/,
      // connectors/). Every migration escape valve that once lived here —
      // useTopLevelRegex, noNestedTernary, noAssignInExpressions,
      // noBitwiseOperators, noImplicitAnyLet, noEvolvingTypes, useTemplate,
      // and (as of 2026-04-22) noExcessiveCognitiveComplexity — has been
      // eliminated and its violations fixed in-place. This override keeps
      // noExcessiveCognitiveComplexity at "error" so any production
      // function above Biome's default budget of 20 fails CI, matching
      // the bar every other package already holds. Tests are excluded
      // (see the *.test.ts override below) because parametric test
      // bodies can legitimately exceed the budget.
      "includes": [
        "src/**/*.ts",
        "bin/**/*.ts",
        "connectors/**/*.ts",
        "!**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "error"
          }
        }
      }
    },
    {
      // noAwaitInLoops policy boundary. Audited every one of the 238
      // baseline findings (2026-07): the package's dominant shapes are the
      // Collection Profile protocol's ordered record emission
      // (emit/emitRecord/emitProtocol — the runtime consumes these as a
      // stream and requires in-order delivery), rate-limited/paginated API
      // walks and browser-page interaction (Playwright drives one page at
      // a time; a for-loop of page actions cannot be parallelized against
      // itself), retry/backoff loops (each attempt's outcome gates the
      // next), and incremental file/cursor reads (a single FileHandle's
      // read offset, or a hash accumulator, is inherently ordered). This is
      // the package's central contract (see AGENTS.md's "Scope discipline":
      // connectors own stream-specific cursors; the runtime owns protocol
      // ordering) — not an incidental style choice. `bench/` shares the
      // same shape for a different reason: sequential timing loops that
      // `Promise.all` would corrupt as benchmarks. Genuinely independent
      // per-item work was parallelized instead of exempted (see
      // buildLocalSourceInventory in src/local-source-inventory.ts, fixed
      // in-place with Promise.all). Any new file added under these paths
      // should default to sequential awaits for the same reason; a
      // reviewer proposing real parallelism there fixes it in place rather
      // than relying on this override.
      "includes": [
        "src/**/*.ts",
        "bin/**/*.ts",
        "bench/**/*.ts",
        "connectors/**/*.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noAwaitInLoops": "off"
          }
        }
      }
    },
    {
      // Runner-slice barrel. `src/runner/index.ts` is the load-bearing entry
      // for the publishable `@pdpp/local-collector` package — it exists
      // specifically to give that package a single import path. The
      // noBarrelFile perf concern (large module graphs of unused modules)
      // does not apply: every module re-exported here is used by the
      // collector loop, and the file is intentionally narrow.
      "includes": ["src/runner/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      // Test-file override. Tests are held to the same typecheck + style
      // bar as production code, with two exceptions that are test-idiomatic:
      // (a) useTopLevelRegex — test bodies routinely use inline
      //     /^\d{3}-.../ for `assert.match` calls; perf is irrelevant in
      //     a test runner, and hoisting them would hurt readability.
      // (b) noExcessiveCognitiveComplexity — parametric test bodies can
      //     exceed 20 when iterating many cases; splitting them into
      //     named helpers hurts the at-a-glance diff when a case fails.
      "includes": ["**/*.test.ts"],
      "linter": {
        "rules": {
          "performance": {
            "useTopLevelRegex": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    }
  ]
}
