{
  "protocol_version": "0.1.0",
  "connector_id": "https://registry.pdpp.org/connectors/amazon",
  "connector_key": "amazon",
  "manifest_uri": "https://registry.pdpp.org/connectors/amazon",
  "version": "0.1.0",
  "display_name": "Amazon",
  "icon": {
    "kind": "inline_svg",
    "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path fill=\"#FF9900\" d=\"M.045 18.02c.072-.116.187-.124.348-.022 3.636 2.11 7.594 3.166 11.87 3.166 2.852 0 5.668-.533 8.447-1.595l.315-.14c.138-.06.234-.1.293-.13.226-.088.39-.046.525.13.12.174.09.336-.12.48-.256.19-.6.41-1.006.654-1.244.743-2.64 1.316-4.185 1.726a17.617 17.617 0 01-10.951-.577 17.88 17.88 0 01-5.43-3.35c-.1-.074-.151-.15-.151-.22 0-.047.021-.09.051-.13zm6.565-6.218c0-1.005.247-1.863.743-2.577.495-.71 1.17-1.25 2.04-1.615.796-.335 1.756-.575 2.912-.72.39-.046 1.033-.103 1.92-.174v-.37c0-.93-.105-1.558-.3-1.875-.302-.43-.78-.65-1.44-.65h-.182c-.48.046-.896.196-1.246.46-.35.27-.575.63-.675 1.096-.06.3-.206.465-.435.51l-2.52-.315c-.248-.06-.372-.18-.372-.39 0-.046.007-.09.022-.15.247-1.29.855-2.25 1.82-2.88.976-.616 2.1-.975 3.39-1.05h.54c1.65 0 2.957.434 3.888 1.29.135.15.27.3.405.48.12.165.224.314.283.45.075.134.15.33.195.57.06.254.105.42.135.51.03.104.062.3.076.615.01.313.02.493.02.553v5.28c0 .376.06.72.165 1.036.105.313.21.54.315.674l.51.674c.09.136.136.256.136.36 0 .12-.06.226-.18.314-1.2 1.05-1.86 1.62-1.963 1.71-.165.135-.375.15-.63.045a6.062 6.062 0 01-.526-.496l-.31-.347a9.391 9.391 0 01-.317-.42l-.3-.435c-.81.886-1.603 1.44-2.4 1.665-.494.15-1.093.227-1.83.227-1.11 0-2.04-.343-2.76-1.034-.72-.69-1.08-1.665-1.08-2.94l-.05-.076zm3.753-.438c0 .566.14 1.02.425 1.364.285.34.675.512 1.155.512.045 0 .106-.007.195-.02.09-.016.134-.023.166-.023.614-.16 1.08-.553 1.424-1.178.165-.28.285-.58.36-.91.09-.32.12-.59.135-.8.015-.195.015-.54.015-1.005v-.54c-.84 0-1.484.06-1.92.18-1.275.36-1.92 1.17-1.92 2.43l-.035-.02zm9.162 7.027c.03-.06.075-.11.132-.17.362-.243.714-.41 1.05-.5a8.094 8.094 0 011.612-.24c.14-.012.28 0 .41.03.65.06 1.05.168 1.172.33.063.09.099.228.099.39v.15c0 .51-.149 1.11-.424 1.8-.278.69-.664 1.248-1.156 1.68-.073.06-.14.09-.197.09-.03 0-.06 0-.09-.012-.09-.044-.107-.12-.064-.24.54-1.26.806-2.143.806-2.64 0-.15-.03-.27-.087-.344-.145-.166-.55-.257-1.224-.257-.243 0-.533.016-.87.046-.363.045-.7.09-1 .135-.09 0-.148-.014-.18-.044-.03-.03-.036-.047-.02-.077 0-.017.006-.03.02-.063v-.06z\" /></svg>",
    "color": "#FF9900"
  },
  "runtime_requirements": {
    "bindings": {
      "network": {
        "required": true
      },
      "browser": {
        "required": true
      }
    }
  },
  "setup": {
    "modality": "static_secret",
    "credential_capture": {
      "kind": "username_password",
      "label": "Amazon sign-in details",
      "description": "Seal the Amazon sign-in details for this source. The connector uses them only for this source's browser-backed collection.",
      "submit_label": "Save Amazon credential and start first sync",
      "fields": [
        {
          "name": "username",
          "label": "Amazon email or phone",
          "type": "text",
          "required": true,
          "secret": true,
          "autocomplete": "username",
          "env": ["AMAZON_USERNAME"]
        },
        {
          "name": "password",
          "label": "Amazon password",
          "type": "password",
          "required": true,
          "secret": true,
          "autocomplete": "current-password",
          "env": ["AMAZON_PASSWORD"]
        }
      ]
    }
  },
  "capabilities": {
    "human_interaction": ["manual_action", "otp"],
    "refresh_policy": {
      "recommended_mode": "manual",
      "minimum_interval_seconds": 7200,
      "maximum_staleness_seconds": 86400,
      "interaction_posture": "otp_likely",
      "rate_limit_sensitivity": "medium",
      "bot_detection_sensitivity": "high",
      "background_safe": true,
      "assisted_after_owner_auth": true,
      "rationale": "Amazon remains manual by default because sign-in and anti-bot checks are common, but an owner can explicitly opt into a background schedule after authenticating the connection."
    },
    "public_listing": {
      "tier": "supported"
    }
  },
  "streams": [
    {
      "name": "orders",
      "required": true,
      "description": "Amazon retail orders scraped from Your Orders.",
      "compaction_fingerprint": {
        "exclude_keys": ["fetched_at"]
      },
      "display": {
        "label": "Your Amazon orders",
        "detail": "Order IDs, dates, totals, delivery status, shipping summaries, payment method summary, recipient name. Per-item breakdowns live in the order_items stream."
      },
      "semantics": "mutable_state",
      "schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "order_date": {
            "type": "string",
            "format": "date",
            "x_pdpp_role": "event-time"
          },
          "order_total": {
            "type": ["string", "null"]
          },
          "order_total_cents": {
            "type": ["integer", "null"]
          },
          "delivery_status": {
            "type": ["string", "null"]
          },
          "status_detail": {
            "type": ["string", "null"],
            "x_pdpp_role": "secondary"
          },
          "recipient_name": {
            "type": ["string", "null"],
            "x_pdpp_role": "primary-title"
          },
          "shipping_address_summary": {
            "type": ["string", "null"]
          },
          "payment_method_summary": {
            "type": ["string", "null"]
          },
          "gift_order": {
            "type": "boolean"
          },
          "digital_order": {
            "type": "boolean"
          },
          "item_count": {
            "type": "integer"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["id", "order_date"]
      },
      "primary_key": ["id"],
      "cursor_field": "order_date",
      "consent_time_field": "order_date",
      "selection": {
        "fields": true,
        "resources": true
      },
      "incremental": true,
      "views": [
        {
          "id": "reconciliation",
          "label": "Fields for matching to bank/YNAB transactions",
          "fields": [
            "id",
            "order_date",
            "order_total",
            "order_total_cents",
            "payment_method_summary",
            "delivery_status",
            "item_count"
          ]
        },
        {
          "id": "full",
          "label": "Everything on the order row",
          "fields": [
            "id",
            "order_date",
            "order_total",
            "order_total_cents",
            "delivery_status",
            "status_detail",
            "recipient_name",
            "shipping_address_summary",
            "payment_method_summary",
            "gift_order",
            "digital_order",
            "item_count",
            "fetched_at"
          ]
        }
      ],
      "query": {
        "search": {
          "lexical_fields": [
            "recipient_name",
            "shipping_address_summary",
            "status_detail",
            "payment_method_summary"
          ]
        },
        "range_filters": {
          "order_date": ["gte", "gt", "lte", "lt"],
          "order_total_cents": ["gte", "gt", "lte", "lt"],
          "item_count": ["gte", "gt", "lte", "lt"]
        },
        "aggregations": {
          "count": true,
          "group_by_time": ["order_date"]
        }
      },
      "coverage_strategy": "checkpoint_window",
      "freshness_strategy": "manual_as_of"
    },
    {
      "name": "order_items",
      "description": "Line items within Amazon orders.",
      "display": {
        "label": "Your order line items",
        "detail": "Product titles, ASINs, per-unit prices, quantities, sellers, product URLs, item-level return/refund status."
      },
      "semantics": "mutable_state",
      "schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "order_id": {
            "type": "string"
          },
          "order_date": {
            "type": "string",
            "format": "date",
            "x_pdpp_role": "event-time"
          },
          "asin": {
            "type": ["string", "null"]
          },
          "name": {
            "type": "string",
            "x_pdpp_role": "primary-title"
          },
          "url": {
            "type": ["string", "null"]
          },
          "unit_price": {
            "type": ["string", "null"]
          },
          "unit_price_cents": {
            "type": ["integer", "null"]
          },
          "quantity": {
            "type": "integer"
          },
          "seller": {
            "type": ["string", "null"],
            "x_pdpp_role": "actor"
          },
          "item_image_url": {
            "type": ["string", "null"]
          },
          "returned": {
            "type": "boolean"
          },
          "refund_status": {
            "type": ["string", "null"]
          }
        },
        "required": ["id", "order_id", "order_date", "name"]
      },
      "primary_key": ["id"],
      "cursor_field": "order_date",
      "consent_time_field": "order_date",
      "selection": {
        "fields": true,
        "resources": true
      },
      "incremental": true,
      "relationships": [
        {
          "name": "order",
          "stream": "orders",
          "foreign_key": "order_id",
          "cardinality": "has_one"
        }
      ],
      "query": {
        "search": {
          "lexical_fields": ["name", "seller"]
        },
        "range_filters": {
          "order_date": ["gte", "gt", "lte", "lt"],
          "unit_price_cents": ["gte", "gt", "lte", "lt"],
          "quantity": ["gte", "gt", "lte", "lt"]
        },
        "aggregations": {
          "count": true,
          "group_by_time": ["order_date"]
        }
      },
      "coverage_strategy": "parent_detail_accounting",
      "freshness_strategy": "manual_as_of"
    }
  ],
  "profiles": [
    {
      "id": "reconciliation",
      "label": "Orders for bank/YNAB matching",
      "streams": [
        {
          "name": "orders",
          "view": "reconciliation"
        },
        {
          "name": "order_items"
        }
      ]
    }
  ],
  "reason_display_messages": {
    "empty_first_page_without_diagnostics": "The first page came back empty and we couldn't tell why",
    "empty_first_page_without_terminal_signal": "The first page came back empty with no sign it was really the end",
    "list_page_navigation_failed": "We couldn't load an orders page, so we stopped before advancing",
    "list_page_shape_check_failed": "The page didn't look like we expected",
    "no_orders_text": "This account shows no orders to import",
    "pagination_exhausted": "We reached the end of the available pages",
    "renderer_diagnostics_failed": "We couldn't inspect an empty orders page, so we stopped before advancing",
    "selector_drift": "The page layout changed and we couldn't find what we needed",
    "source_auth_or_challenge": "We need you to sign in or pass a verification check to continue",
    "unparseable_order_date": "We skipped some orders because their dates couldn't be read"
  }
}
