{
  "protocol_version": "0.1.0",
  "connector_id": "https://registry.pdpp.org/connectors/doordash",
  "connector_key": "doordash",
  "manifest_uri": "https://registry.pdpp.org/connectors/doordash",
  "version": "0.1.0",
  "display_name": "DoorDash",
  "icon": {
    "kind": "inline_svg",
    "svg": "<svg fill=\"#FF3008\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M23.071 8.409a6.09 6.09 0 00-5.396-3.228H.584A.589.589 0 00.17 6.184L3.894 9.93a1.752 1.752 0 001.242.516h12.049a1.554 1.554 0 11.031 3.108H8.91a.589.589 0 00-.415 1.003l3.725 3.747a1.75 1.75 0 001.242.516h3.757c4.887 0 8.584-5.225 5.852-10.413\" /></svg>",
    "color": "#FF3008"
  },
  "runtime_requirements": {
    "bindings": {
      "network": {
        "required": true
      },
      "browser": {
        "required": true
      }
    }
  },
  "capabilities": {
    "human_interaction": ["manual_action"],
    "refresh_policy": {
      "recommended_mode": "manual",
      "minimum_interval_seconds": 3600,
      "interaction_posture": "manual_action_likely",
      "rate_limit_sensitivity": "medium",
      "bot_detection_sensitivity": "high",
      "background_safe": false,
      "rationale": "DoorDash order history is browser-scraped; treat as manual to avoid bot-detection signals."
    },
    "public_listing": {
      "tier": "development"
    }
  },
  "streams": [
    {
      "name": "orders",
      "description": "DoorDash food-delivery orders.",
      "display": {
        "label": "Your DoorDash orders",
        "detail": "Order date, restaurant, items, prices, tips, tax, delivery status, delivery address, fee breakdown."
      },
      "semantics": "mutable_state",
      "schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "order_date": {
            "type": ["string", "null"],
            "format": "date-time",
            "x_pdpp_role": "event-time"
          },
          "restaurant_name": {
            "type": ["string", "null"]
          },
          "status": {
            "type": ["string", "null"]
          },
          "subtotal_cents": {
            "type": ["integer", "null"]
          },
          "tax_cents": {
            "type": ["integer", "null"]
          },
          "tip_cents": {
            "type": ["integer", "null"]
          },
          "delivery_fee_cents": {
            "type": ["integer", "null"]
          },
          "service_fee_cents": {
            "type": ["integer", "null"]
          },
          "total_cents": {
            "type": ["integer", "null"]
          },
          "delivery_address": {
            "type": ["string", "null"]
          },
          "payment_method_summary": {
            "type": ["string", "null"],
            "x_pdpp_role": "secondary"
          },
          "item_count": {
            "type": ["integer", "null"]
          }
        },
        "required": ["id"]
      },
      "primary_key": ["id"],
      "cursor_field": "order_date",
      "consent_time_field": "order_date",
      "selection": {
        "fields": true,
        "resources": true
      },
      "incremental": true,
      "query": {
        "search": {
          "lexical_fields": ["restaurant_name"]
        },
        "range_filters": {
          "order_date": ["gte", "gt", "lte", "lt"]
        },
        "aggregations": {
          "count": true,
          "group_by_time": ["order_date"],
          "group_by": ["status"]
        }
      },
      "coverage_strategy": "checkpoint_window",
      "freshness_strategy": "manual_as_of"
    },
    {
      "name": "order_items",
      "description": "Individual items within DoorDash orders.",
      "display": {
        "label": "Your DoorDash order items",
        "detail": "Item name, quantity, unit price, customizations."
      },
      "semantics": "mutable_state",
      "schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "order_id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "x_pdpp_role": "primary-title"
          },
          "quantity": {
            "type": "integer"
          },
          "unit_price_cents": {
            "type": ["integer", "null"]
          },
          "customizations": {
            "type": "array"
          }
        },
        "required": ["id", "order_id", "name"]
      },
      "primary_key": ["id"],
      "selection": {
        "fields": true,
        "resources": true
      },
      "incremental": true,
      "relationships": [
        {
          "name": "order",
          "stream": "orders",
          "foreign_key": "order_id",
          "cardinality": "has_one"
        }
      ],
      "query": {
        "search": {
          "lexical_fields": ["name"]
        }
      },
      "coverage_strategy": "parent_detail_accounting",
      "freshness_strategy": "manual_as_of"
    }
  ],
  "reason_display_messages": {
    "doordash_graphql_wiring_pending": "DoorDash support isn't wired up yet"
  }
}
