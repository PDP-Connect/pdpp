{
  "protocol_version": "0.1.0",
  "connector_id": "https://registry.pdpp.org/connectors/uber",
  "connector_key": "uber",
  "manifest_uri": "https://registry.pdpp.org/connectors/uber",
  "version": "0.1.0",
  "display_name": "Uber",
  "icon": {
    "kind": "inline_svg",
    "svg": "<svg fill=\"#000000\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M0 7.97v4.958c0 1.867 1.302 3.101 3 3.101.826 0 1.562-.316 2.094-.87v.736H6.27V7.97H5.082v4.888c0 1.257-.85 2.106-1.947 2.106-1.11 0-1.946-.827-1.946-2.106V7.971H0zm7.44 0v7.925h1.13v-.725c.521.532 1.257.86 2.06.86a3.006 3.006 0 0 0 3.034-3.01 3.01 3.01 0 0 0-3.033-3.024 2.86 2.86 0 0 0-2.049.861V7.971H7.439zm9.869 2.038c-1.687 0-2.965 1.37-2.965 3 0 1.72 1.334 3.01 3.066 3.01 1.053 0 1.913-.463 2.49-1.233l-.826-.611c-.43.577-.996.847-1.664.847-.973 0-1.753-.7-1.912-1.64h4.697v-.373c0-1.72-1.222-3-2.886-3zm6.295.068c-.634 0-1.098.294-1.381.758v-.713h-1.131v5.774h1.142V12.61c0-.894.544-1.47 1.291-1.47H24v-1.065h-.396zm-6.319.928c.85 0 1.564.588 1.756 1.47H15.52c.203-.882.916-1.47 1.765-1.47zm-6.732.012c1.086 0 1.98.883 1.98 2.004a1.993 1.993 0 0 1-1.98 2.001A1.989 1.989 0 0 1 8.56 13.02a1.99 1.99 0 0 1 1.992-2.004z\" /></svg>",
    "color": "#000000"
  },
  "runtime_requirements": {
    "bindings": {
      "network": {
        "required": true
      },
      "browser": {
        "required": true
      }
    }
  },
  "capabilities": {
    "human_interaction": ["manual_action"],
    "refresh_policy": {
      "recommended_mode": "manual",
      "minimum_interval_seconds": 3600,
      "interaction_posture": "manual_action_likely",
      "rate_limit_sensitivity": "medium",
      "bot_detection_sensitivity": "high",
      "background_safe": false,
      "rationale": "Uber trip history is browser-scraped behind a login wall; refresh manually."
    },
    "public_listing": {
      "tier": "development"
    }
  },
  "streams": [
    {
      "name": "trips",
      "description": "Uber trips (ride-share + Uber Eats deliveries if mingled).",
      "display": {
        "label": "Your Uber trips",
        "detail": "Trip date, pickup/dropoff locations, distance, duration, fare breakdown, driver, car type, status. Supports reconciliation to bank-statement 'UBER *TRIP' entries."
      },
      "semantics": "mutable_state",
      "schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": ["string", "null"]
          },
          "product_type": {
            "type": ["string", "null"]
          },
          "requested_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "started_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "x_pdpp_role": "event-time"
          },
          "completed_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "pickup_address": {
            "type": ["string", "null"]
          },
          "pickup_lat": {
            "type": ["number", "null"]
          },
          "pickup_lng": {
            "type": ["number", "null"]
          },
          "dropoff_address": {
            "type": ["string", "null"]
          },
          "dropoff_lat": {
            "type": ["number", "null"]
          },
          "dropoff_lng": {
            "type": ["number", "null"]
          },
          "distance_meters": {
            "type": ["number", "null"]
          },
          "duration_seconds": {
            "type": ["integer", "null"]
          },
          "fare_total": {
            "type": ["string", "null"]
          },
          "fare_total_cents": {
            "type": ["integer", "null"]
          },
          "currency": {
            "type": ["string", "null"]
          },
          "tip_cents": {
            "type": ["integer", "null"]
          },
          "surge_multiplier": {
            "type": ["number", "null"]
          },
          "driver_name": {
            "type": ["string", "null"]
          },
          "vehicle_description": {
            "type": ["string", "null"]
          },
          "receipt_url": {
            "type": ["string", "null"]
          }
        },
        "required": ["id"]
      },
      "primary_key": ["id"],
      "cursor_field": "completed_at",
      "consent_time_field": "requested_at",
      "selection": {
        "fields": true,
        "resources": true
      },
      "incremental": true,
      "views": [
        {
          "id": "reconciliation",
          "label": "Fields for YNAB matching",
          "fields": [
            "id",
            "completed_at",
            "fare_total",
            "fare_total_cents",
            "pickup_address",
            "dropoff_address",
            "product_type"
          ]
        }
      ],
      "query": {
        "search": {
          "lexical_fields": ["driver_name", "vehicle_description"]
        },
        "range_filters": {
          "started_at": ["gte", "gt", "lte", "lt"],
          "requested_at": ["gte", "gt", "lte", "lt"]
        },
        "aggregations": {
          "count": true,
          "group_by_time": ["started_at"],
          "group_by": ["status", "product_type"]
        }
      },
      "coverage_strategy": "checkpoint_window",
      "freshness_strategy": "manual_as_of"
    }
  ],
  "reason_display_messages": {
    "uber_graphql_wiring_pending": "Uber support isn't wired up yet"
  }
}
