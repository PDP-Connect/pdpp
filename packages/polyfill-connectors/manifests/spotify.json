{
  "protocol_version": "0.1.0",
  "connector_id": "https://registry.pdpp.org/connectors/spotify",
  "connector_key": "spotify",
  "manifest_uri": "https://registry.pdpp.org/connectors/spotify",
  "version": "0.1.0",
  "display_name": "Spotify",
  "icon": {
    "kind": "inline_svg",
    "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 501 500\"><path d=\"M250.488 0C112.412 0 0.487793 111.924 0.487793 250C0.487793 388.076 112.412 500 250.488 500C388.564 500 500.488 388.076 500.488 250C500.488 111.941 388.564 0.017059 250.488 0ZM365.141 360.56C360.655 367.929 351.051 370.232 343.715 365.745C285.015 329.87 211.116 321.767 124.097 341.641C115.704 343.569 107.346 338.315 105.435 329.922C103.507 321.528 108.744 313.17 117.154 311.259C212.378 289.509 294.074 298.874 359.973 339.133C367.308 343.654 369.645 353.224 365.141 360.56ZM395.728 292.511C390.082 301.689 378.072 304.555 368.912 298.925C301.733 257.625 199.277 245.667 119.799 269.788C109.495 272.91 98.6113 267.093 95.4724 256.807C92.3677 246.503 98.1848 235.636 108.471 232.497C199.26 204.947 312.139 218.287 389.297 265.711C398.475 271.358 401.375 283.35 395.728 292.511ZM398.355 221.614C317.769 173.763 184.845 169.362 107.908 192.699C95.5577 196.452 82.4905 189.475 78.7546 177.124C75.0187 164.773 81.9788 151.706 94.3465 147.953C182.661 121.153 329.454 126.322 422.221 181.389C433.326 187.99 436.977 202.337 430.392 213.425C423.825 224.548 409.444 228.216 398.355 221.614Z\" fill=\"#1FD760\" /></svg>",
    "color": "#1ED760"
  },
  "setup": {
    "modality": "static_secret",
    "credential_capture": {
      "kind": "access_token",
      "label": "Spotify access token",
      "description": "Paste a Spotify Web API access token with the scopes needed for this source.",
      "submit_label": "Save Spotify token and start first sync",
      "fields": [
        {
          "name": "secret",
          "label": "Spotify access token",
          "type": "password",
          "required": true,
          "secret": true,
          "autocomplete": "off",
          "help_url": "https://developer.spotify.com/documentation/web-api/concepts/access-token",
          "help_text": "Create or obtain a Spotify Web API access token, then paste it here.",
          "env": ["SPOTIFY_ACCESS_TOKEN"]
        }
      ]
    }
  },
  "runtime_requirements": {
    "bindings": {
      "network": {
        "required": true
      }
    }
  },
  "capabilities": {
    "human_interaction": ["credentials"],
    "public_listing": {
      "tier": "development",
      "rationale": "Hidden from the reference dashboard catalog until a credentialed run proves useful records in the deployment."
    },
    "refresh_policy": {
      "recommended_mode": "manual",
      "recommended_interval_seconds": 21600,
      "minimum_interval_seconds": 3600,
      "maximum_staleness_seconds": 86400,
      "interaction_posture": "credentials",
      "rate_limit_sensitivity": "medium",
      "bot_detection_sensitivity": "low",
      "background_safe": false,
      "rationale": "Spotify v0.1 requires a user-provided SPOTIFY_ACCESS_TOKEN and is not yet proven in the reference deployment; do not schedule it as an automatic background connector until a credentialed run succeeds."
    }
  },
  "streams": [
    {
      "name": "playlists",
      "description": "User's playlists.",
      "display": {
        "label": "Your playlists",
        "detail": "Playlist names, ownership, public/collaborative flags, track counts, snapshot IDs."
      },
      "semantics": "mutable_state",
      "schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "x_pdpp_role": "primary-title"
          },
          "owner_id": {
            "type": ["string", "null"]
          },
          "owner_name": {
            "type": ["string", "null"],
            "x_pdpp_role": "actor"
          },
          "public": {
            "type": ["boolean", "null"]
          },
          "collaborative": {
            "type": ["boolean", "null"]
          },
          "track_count": {
            "type": ["integer", "null"]
          },
          "snapshot_id": {
            "type": ["string", "null"]
          },
          "description": {
            "type": ["string", "null"],
            "x_pdpp_role": "secondary"
          }
        },
        "required": ["id", "name"]
      },
      "primary_key": ["id"],
      "selection": {
        "fields": true,
        "resources": true
      },
      "incremental": false,
      "query": {
        "search": {
          "lexical_fields": ["name", "owner_name", "description"],
          "semantic_fields": ["description"]
        }
      },
      "coverage_strategy": "full_inventory",
      "freshness_strategy": "manual_as_of"
    },
    {
      "name": "saved_tracks",
      "description": "User's saved/liked tracks.",
      "display": {
        "label": "Your saved tracks",
        "detail": "Liked tracks, when they were added, artist/album context."
      },
      "semantics": "mutable_state",
      "schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "x_pdpp_role": "primary-title"
          },
          "artist_names": {
            "type": "array"
          },
          "album_name": {
            "type": ["string", "null"]
          },
          "duration_ms": {
            "type": ["integer", "null"]
          },
          "popularity": {
            "type": ["integer", "null"]
          },
          "added_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "x_pdpp_role": "event-time"
          },
          "isrc": {
            "type": ["string", "null"]
          }
        },
        "required": ["id", "name"]
      },
      "primary_key": ["id"],
      "cursor_field": "added_at",
      "consent_time_field": "added_at",
      "selection": {
        "fields": true,
        "resources": true
      },
      "incremental": true,
      "query": {
        "search": {
          "lexical_fields": ["name", "album_name"]
        },
        "aggregations": {
          "count": true,
          "group_by_time": ["added_at"]
        },
        "range_filters": {
          "added_at": ["gte", "gt", "lte", "lt"]
        }
      },
      "coverage_strategy": "checkpoint_window",
      "freshness_strategy": "manual_as_of"
    },
    {
      "name": "top_artists",
      "description": "Top artists per time range (short/medium/long).",
      "display": {
        "label": "Your top artists",
        "detail": "Top artists over last 4 weeks, 6 months, and all time."
      },
      "semantics": "mutable_state",
      "schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "x_pdpp_role": "primary-title"
          },
          "genres": {
            "type": "array"
          },
          "popularity": {
            "type": ["integer", "null"]
          },
          "followers": {
            "type": ["integer", "null"]
          },
          "time_range": {
            "type": "string"
          }
        },
        "required": ["id", "name"]
      },
      "primary_key": ["id", "time_range"],
      "selection": {
        "fields": true,
        "resources": true
      },
      "incremental": false,
      "query": {
        "search": {
          "lexical_fields": ["name"]
        }
      },
      "coverage_strategy": "full_inventory",
      "freshness_strategy": "manual_as_of"
    },
    {
      "name": "recently_played",
      "description": "Recent play events returned by Spotify; the Web API limits each page to 50 items and the connector follows cursor pagination.",
      "display": {
        "label": "Your recent plays",
        "detail": "Recent track plays with played_at timestamps. API limited to last 50."
      },
      "semantics": "append_only",
      "schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "track_id": {
            "type": "string"
          },
          "track_name": {
            "type": "string",
            "x_pdpp_role": "primary-title"
          },
          "artist_names": {
            "type": "array",
            "x_pdpp_role": "actor"
          },
          "album_name": {
            "type": ["string", "null"]
          },
          "played_at": {
            "type": "string",
            "format": "date-time",
            "x_pdpp_role": "event-time"
          },
          "context_type": {
            "type": ["string", "null"]
          }
        },
        "required": ["id", "track_id", "played_at"]
      },
      "primary_key": ["id"],
      "cursor_field": "played_at",
      "consent_time_field": "played_at",
      "selection": {
        "fields": true,
        "resources": true
      },
      "incremental": true,
      "query": {
        "search": {
          "lexical_fields": ["track_name", "album_name"]
        },
        "aggregations": {
          "count": true,
          "group_by_time": ["played_at"]
        },
        "range_filters": {
          "played_at": ["gte", "gt", "lte", "lt"]
        }
      },
      "coverage_strategy": "checkpoint_window",
      "freshness_strategy": "manual_as_of"
    }
  ]
}
