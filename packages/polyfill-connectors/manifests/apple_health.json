{
  "protocol_version": "0.1.0",
  "connector_id": "https://registry.pdpp.dev/connectors/apple-health",
  "connector_key": "apple-health",
  "manifest_uri": "https://registry.pdpp.dev/connectors/apple-health",
  "version": "0.1.0",
  "display_name": "Apple Health",
  "runtime_requirements": {
    "bindings": {
      "filesystem": {
        "required": true
      }
    },
    "environment_variables": ["APPLE_HEALTH_EXPORT_DIR"]
  },
  "setup": {
    "modality": "manual_or_upload",
    "manual_or_upload": {
      "label": "Apple Health export",
      "description": "Export your data from the iPhone Health app, extract export.xml from the resulting .zip, then upload export.xml here.",
      "acquisition_methods": [
        {
          "label": "Export from the Health app",
          "platform": "ios",
          "posture": "primary",
          "detail": "Open the Health app, tap your profile photo in the top right, scroll down, and tap Export All Health Data. This produces a .zip file. Unzip it (it contains apple_health_export/export.xml), then upload export.xml here.",
          "help_url": "https://support.apple.com/guide/iphone/share-your-health-data-iph5ede58c3d/ios"
        }
      ],
      "accepted_file_extensions": [".xml"],
      "import_dir_env_var": "APPLE_HEALTH_EXPORT_DIR",
      "help_url": "https://support.apple.com/guide/iphone/share-your-health-data-iph5ede58c3d/ios",
      "help_text": "Apple Health does not expose records through an account API or OAuth grant. This source imports an owner-exported export.xml from the iPhone Health app. The .zip Health produces must be extracted first; this connector does not yet accept the .zip directly.",
      "large_file_fallback": "This connector accepts uploads up to the deployment limit shown above. There is currently no alternate upload path for larger files — ask your PDPP operator to raise the deployment limit if your export exceeds it."
    }
  },
  "capabilities": {
    "human_interaction": [],
    "refresh_policy": {
      "recommended_mode": "manual",
      "interaction_posture": "manual_action_likely",
      "rate_limit_sensitivity": "low",
      "bot_detection_sensitivity": "low",
      "background_safe": false,
      "rationale": "Apple Health imports require the user to produce a new export.xml from iOS; cannot be refreshed in the background."
    },
    "public_listing": {
      "tier": "development"
    }
  },
  "streams": [
    {
      "name": "records",
      "description": "Apple Health records from an export.xml.",
      "display": {
        "label": "Your Apple Health records",
        "detail": "Every Health record: type (steps, heart rate, sleep, weight, etc.), source (app/device), value, unit, start/end dates. Expected from a Health.app export."
      },
      "semantics": "append_only",
      "schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "source_name": {
            "type": ["string", "null"],
            "x_pdpp_role": "actor"
          },
          "source_version": {
            "type": ["string", "null"]
          },
          "unit": {
            "type": ["string", "null"]
          },
          "value": {
            "type": ["number", "null"]
          },
          "value_raw": {
            "type": ["string", "null"]
          },
          "start_date": {
            "type": "string",
            "format": "date-time",
            "x_pdpp_role": "event-time"
          },
          "end_date": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        },
        "required": ["id", "type", "start_date"]
      },
      "primary_key": ["id"],
      "cursor_field": "start_date",
      "consent_time_field": "start_date",
      "selection": {
        "fields": true,
        "resources": true
      },
      "incremental": true,
      "query": {
        "range_filters": {
          "start_date": ["gte", "gt", "lte", "lt"],
          "end_date": ["gte", "gt", "lte", "lt"]
        },
        "aggregations": {
          "count": true,
          "group_by_time": ["start_date"],
          "group_by": ["type"]
        }
      },
      "coverage_strategy": "snapshot_import_receipt",
      "freshness_strategy": "manual_as_of"
    },
    {
      "name": "workouts",
      "description": "Apple Health workouts.",
      "display": {
        "label": "Your workouts",
        "detail": "Workout type, duration, energy burned, distance, start/end dates."
      },
      "semantics": "append_only",
      "schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "workout_activity_type": {
            "type": ["string", "null"]
          },
          "duration_minutes": {
            "type": ["number", "null"]
          },
          "total_energy_burned_kcal": {
            "type": ["number", "null"]
          },
          "total_distance_km": {
            "type": ["number", "null"]
          },
          "source_name": {
            "type": ["string", "null"],
            "x_pdpp_role": "actor"
          },
          "start_date": {
            "type": "string",
            "format": "date-time",
            "x_pdpp_role": "event-time"
          },
          "end_date": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        },
        "required": ["id", "start_date"]
      },
      "primary_key": ["id"],
      "cursor_field": "start_date",
      "consent_time_field": "start_date",
      "selection": {
        "fields": true,
        "resources": true
      },
      "incremental": true,
      "query": {
        "range_filters": {
          "start_date": ["gte", "gt", "lte", "lt"],
          "end_date": ["gte", "gt", "lte", "lt"]
        },
        "aggregations": {
          "count": true,
          "group_by_time": ["start_date"],
          "group_by": ["workout_activity_type"]
        }
      },
      "coverage_strategy": "snapshot_import_receipt",
      "freshness_strategy": "manual_as_of"
    }
  ],
  "reason_display_messages": {
    "export_not_found": "We couldn't find an export to import"
  }
}
