{
  "protocol_version": "0.1.0",
  "connector_id": "https://registry.pdpp.org/connectors/anthropic",
  "connector_key": "anthropic",
  "manifest_uri": "https://registry.pdpp.org/connectors/anthropic",
  "version": "0.1.0",
  "display_name": "Claude (Anthropic)",
  "icon": {
    "kind": "inline_svg",
    "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 100\" fill=\"none\"><circle cx=\"50\" cy=\"50\" r=\"6\" fill=\"#D97745\" /><g stroke=\"#D97745\" stroke-linecap=\"round\" stroke-width=\"6\"><path d=\"M50 8v18\" /><path d=\"M50 74v18\" /><path d=\"M8 50h18\" /><path d=\"M74 50h18\" /><path d=\"M20.3 20.3l12.7 12.7\" /><path d=\"M67 67l12.7 12.7\" /><path d=\"M79.7 20.3L67 33\" /><path d=\"M33 67 20.3 79.7\" /><path d=\"M29 11.6 36 28.2\" /><path d=\"M64 71.8 71 88.4\" /><path d=\"M11.6 29 28.2 36\" /><path d=\"M71.8 64 88.4 71\" /><path d=\"M88.4 29 71.8 36\" /><path d=\"M28.2 64 11.6 71\" /><path d=\"M71 11.6 64 28.2\" /><path d=\"M36 71.8 29 88.4\" /></g></svg>",
    "color": "#D97757"
  },
  "runtime_requirements": {
    "bindings": {
      "network": {
        "required": true
      },
      "browser": {
        "required": true
      }
    }
  },
  "capabilities": {
    "human_interaction": ["manual_action"],
    "refresh_policy": {
      "recommended_mode": "manual",
      "minimum_interval_seconds": 3600,
      "interaction_posture": "manual_action_likely",
      "rate_limit_sensitivity": "medium",
      "bot_detection_sensitivity": "high",
      "background_safe": false,
      "rationale": "Claude.ai conversations are browser-scraped behind a login wall; background polling risks lockouts."
    },
    "public_listing": {
      "tier": "development"
    }
  },
  "streams": [
    {
      "name": "conversations",
      "description": "Claude.ai conversations.",
      "display": {
        "label": "Your Claude conversations",
        "detail": "Conversation titles, create/update times, project membership, message counts."
      },
      "semantics": "mutable_state",
      "schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": ["string", "null"],
            "x_pdpp_role": "primary-title"
          },
          "create_time": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "update_time": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "project_id": {
            "type": ["string", "null"]
          },
          "model": {
            "type": ["string", "null"]
          },
          "message_count": {
            "type": ["integer", "null"]
          }
        },
        "required": ["id"]
      },
      "primary_key": ["id"],
      "cursor_field": "update_time",
      "consent_time_field": "create_time",
      "selection": {
        "fields": true,
        "resources": true
      },
      "incremental": true,
      "query": {
        "search": {
          "lexical_fields": ["title"],
          "semantic_fields": ["title"]
        },
        "range_filters": {
          "create_time": ["gte", "gt", "lte", "lt"]
        },
        "aggregations": {
          "count": true,
          "group_by_time": ["create_time"]
        }
      },
      "coverage_strategy": "checkpoint_window",
      "freshness_strategy": "manual_as_of"
    },
    {
      "name": "messages",
      "description": "Messages within Claude conversations.",
      "display": {
        "label": "Your Claude messages",
        "detail": "Role, content, model, creation time, per-conversation ordering."
      },
      "semantics": "append_only",
      "schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "conversation_id": {
            "type": "string"
          },
          "role": {
            "type": ["string", "null"],
            "x_pdpp_role": "actor"
          },
          "content": {
            "type": ["string", "null"],
            "x_pdpp_role": "primary-title"
          },
          "model": {
            "type": ["string", "null"]
          },
          "create_time": {
            "type": ["string", "null"],
            "format": "date-time",
            "x_pdpp_role": "event-time"
          }
        },
        "required": ["id", "conversation_id"]
      },
      "primary_key": ["id"],
      "cursor_field": "create_time",
      "consent_time_field": "create_time",
      "selection": {
        "fields": true,
        "resources": true
      },
      "incremental": true,
      "relationships": [
        {
          "name": "conversation",
          "stream": "conversations",
          "foreign_key": "conversation_id",
          "cardinality": "has_one"
        }
      ],
      "query": {
        "search": {
          "lexical_fields": ["content"],
          "semantic_fields": ["content"]
        },
        "range_filters": {
          "create_time": ["gte", "gt", "lte", "lt"]
        },
        "aggregations": {
          "count": true,
          "group_by_time": ["create_time"]
        }
      },
      "coverage_strategy": "checkpoint_window",
      "freshness_strategy": "manual_as_of"
    },
    {
      "name": "projects",
      "description": "Claude Projects the user has created.",
      "display": {
        "label": "Your Claude projects",
        "detail": "Project names, descriptions, create times, associated conversation counts."
      },
      "semantics": "mutable_state",
      "schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "x_pdpp_role": "primary-title"
          },
          "description": {
            "type": ["string", "null"],
            "x_pdpp_role": "secondary"
          },
          "create_time": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "update_time": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        },
        "required": ["id", "name"]
      },
      "primary_key": ["id"],
      "cursor_field": "update_time",
      "consent_time_field": "create_time",
      "selection": {
        "fields": true,
        "resources": true
      },
      "incremental": true,
      "query": {
        "search": {
          "lexical_fields": ["name", "description"],
          "semantic_fields": ["description"]
        },
        "range_filters": {
          "create_time": ["gte", "gt", "lte", "lt"]
        },
        "aggregations": {
          "count": true,
          "group_by_time": ["create_time"]
        }
      },
      "coverage_strategy": "full_inventory",
      "freshness_strategy": "manual_as_of"
    }
  ],
  "reason_display_messages": {
    "claude_api_wiring_pending": "Claude API support isn't wired up yet"
  }
}
