{
  "protocol_version": "0.1.0",
  "connector_id": "https://registry.pdpp.dev/connectors/venmo",
  "connector_key": "venmo",
  "manifest_uri": "https://registry.pdpp.dev/connectors/venmo",
  "version": "0.2.0",
  "display_name": "Venmo",
  "runtime_requirements": {
    "bindings": {
      "network": {
        "required": true
      },
      "browser": {
        "required": true
      }
    }
  },
  "setup": {
    "modality": "static_secret",
    "credential_capture": {
      "kind": "username_password",
      "label": "Venmo sign-in details (optional)",
      "description": "Optionally save Venmo sign-in details to assist automated re-login for this source's browser-backed collection. Venmo's internal API rejects synthetic client credentials, so this connector authenticates through a real, owner-driven browser session instead — leave these blank to sign in by hand in the secure browser every time a session needs to be (re)established.",
      "submit_label": "Save Venmo credential and start first sync",
      "required": false,
      "fields": [
        {
          "name": "username",
          "label": "Venmo phone, email, or username",
          "type": "text",
          "required": true,
          "secret": true,
          "autocomplete": "username",
          "env": ["VENMO_USERNAME"]
        },
        {
          "name": "password",
          "label": "Venmo password",
          "type": "password",
          "required": true,
          "secret": true,
          "autocomplete": "current-password",
          "env": ["VENMO_PASSWORD"]
        }
      ]
    }
  },
  "capabilities": {
    "human_interaction": ["manual_action", "otp"],
    "refresh_policy": {
      "recommended_mode": "manual",
      "recommended_interval_seconds": 21600,
      "minimum_interval_seconds": 3600,
      "maximum_staleness_seconds": 86400,
      "interaction_posture": "otp_likely",
      "rate_limit_sensitivity": "medium",
      "bot_detection_sensitivity": "high",
      "background_safe": false,
      "assisted_after_owner_auth": true,
      "rationale": "Manual only while this connector stays unproven against a real account. Once proven, the session persists in the profile after first login, so background scheduling can be revisited then."
    },
    "public_listing": {
      "tier": "preview",
      "rationale": "Real collection logic (browser-session auth against api.venmo.com's own JSON endpoints via the page's own cookie jar, matching the reddit/amazon pattern), verified by 70 unit/integration tests covering parsers, schemas, cursor behavior, redaction, and the credential-submit retry boundary (B4). Listed as Preview rather than Supported because no live run against a real Venmo account has been recorded yet. The owner opted this into listing to perform that first real run."
    }
  },
  "streams": [
    {
      "name": "profile",
      "required": true,
      "description": "The authenticated owner's own Venmo account.",
      "display": {
        "label": "Your Venmo profile",
        "detail": "Display name, username, phone, profile picture, about text, join date, and whether the account is a business account. No balance or payment-method data."
      },
      "semantics": "mutable_state",
      "schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": ["string", "null"]
          },
          "first_name": {
            "type": ["string", "null"]
          },
          "last_name": {
            "type": ["string", "null"]
          },
          "display_name": {
            "type": ["string", "null"],
            "x_pdpp_role": "primary-title"
          },
          "phone": {
            "type": ["string", "null"]
          },
          "profile_picture_url": {
            "type": ["string", "null"],
            "format": "uri"
          },
          "about": {
            "type": ["string", "null"],
            "x_pdpp_role": "secondary"
          },
          "date_joined": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "is_business": {
            "type": ["boolean", "null"]
          }
        },
        "required": ["id"]
      },
      "primary_key": ["id"],
      "selection": {
        "fields": true,
        "resources": true
      },
      "incremental": false,
      "query": {
        "search": {
          "lexical_fields": [
            "username",
            "display_name",
            "first_name",
            "last_name",
            "about"
          ],
          "semantic_fields": ["about"]
        },
        "range_filters": {
          "date_joined": ["gte", "gt", "lte", "lt"]
        },
        "aggregations": {
          "count": true
        }
      },
      "coverage_strategy": "full_inventory",
      "freshness_strategy": "scheduled_window"
    },
    {
      "name": "friends",
      "required": true,
      "description": "The owner's Venmo friends list.",
      "display": {
        "label": "Your Venmo friends",
        "detail": "Display name, username, phone (when visible), profile picture, about text, join date, and whether the entry is a group or an active user. No payment history."
      },
      "semantics": "mutable_state",
      "schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": ["string", "null"]
          },
          "first_name": {
            "type": ["string", "null"]
          },
          "last_name": {
            "type": ["string", "null"]
          },
          "display_name": {
            "type": ["string", "null"],
            "x_pdpp_role": "primary-title"
          },
          "phone": {
            "type": ["string", "null"]
          },
          "profile_picture_url": {
            "type": ["string", "null"],
            "format": "uri"
          },
          "about": {
            "type": ["string", "null"],
            "x_pdpp_role": "secondary"
          },
          "date_joined": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "is_group": {
            "type": ["boolean", "null"]
          },
          "is_active": {
            "type": ["boolean", "null"]
          }
        },
        "required": ["id"]
      },
      "primary_key": ["id"],
      "selection": {
        "fields": true,
        "resources": true
      },
      "incremental": false,
      "query": {
        "search": {
          "lexical_fields": [
            "username",
            "display_name",
            "first_name",
            "last_name",
            "about"
          ],
          "semantic_fields": ["about"]
        },
        "range_filters": {
          "date_joined": ["gte", "gt", "lte", "lt"]
        },
        "aggregations": {
          "count": true,
          "group_by": ["is_group", "is_active"]
        }
      },
      "coverage_strategy": "full_inventory",
      "freshness_strategy": "scheduled_window"
    },
    {
      "name": "transactions",
      "required": true,
      "description": "Payments sent, requested, and received that are visible to the owner. Amounts in USD cents. Refunds, bank transfers, top-ups, card authorizations/withdrawals, and disbursements are not modeled (see connector header for why).",
      "display": {
        "label": "Your Venmo transactions",
        "detail": "Date, amount (USD cents), payment type (pay/charge), audience (private/friends/public), status, note, device used, and the counterparty (actor/target) on each side of the payment."
      },
      "semantics": "mutable_state",
      "schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "payment_id": {
            "type": ["string", "null"]
          },
          "date_created": {
            "type": "string",
            "format": "date-time",
            "x_pdpp_role": "event-time"
          },
          "date_updated": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "date_completed": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "payment_type": {
            "type": "string",
            "enum": ["pay", "charge"]
          },
          "amount_cents": {
            "type": "integer"
          },
          "audience": {
            "type": ["string", "null"],
            "enum": ["private", "friends", "public", null]
          },
          "status": {
            "type": ["string", "null"],
            "enum": [
              "settled",
              "cancelled",
              "pending",
              "failed",
              "expired",
              null
            ]
          },
          "note": {
            "type": ["string", "null"],
            "x_pdpp_role": "secondary"
          },
          "device_used": {
            "type": ["string", "null"]
          },
          "actor": {
            "type": ["object", "null"],
            "properties": {
              "id": { "type": "string" },
              "username": { "type": ["string", "null"] },
              "display_name": { "type": ["string", "null"] }
            }
          },
          "target": {
            "type": ["object", "null"],
            "properties": {
              "id": { "type": "string" },
              "username": { "type": ["string", "null"] },
              "display_name": { "type": ["string", "null"] }
            }
          },
          "is_owner_actor": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "date_created",
          "payment_type",
          "amount_cents",
          "is_owner_actor"
        ]
      },
      "primary_key": ["id"],
      "cursor_field": "date_created",
      "consent_time_field": "date_created",
      "selection": {
        "fields": true,
        "resources": true
      },
      "incremental": true,
      "query": {
        "search": {
          "lexical_fields": ["note", "status", "payment_type", "device_used"],
          "semantic_fields": ["note"]
        },
        "range_filters": {
          "date_created": ["gte", "gt", "lte", "lt"],
          "date_updated": ["gte", "gt", "lte", "lt"],
          "date_completed": ["gte", "gt", "lte", "lt"],
          "amount_cents": ["gte", "gt", "lte", "lt"]
        },
        "aggregations": {
          "count": true,
          "sum": ["amount_cents"],
          "min": ["date_created", "amount_cents"],
          "max": ["date_created", "amount_cents"],
          "group_by": ["payment_type", "audience", "status", "is_owner_actor"],
          "group_by_time": ["date_created"]
        }
      },
      "coverage_strategy": "checkpoint_window",
      "freshness_strategy": "scheduled_window"
    }
  ]
}
