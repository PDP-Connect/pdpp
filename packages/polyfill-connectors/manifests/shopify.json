{
  "protocol_version": "0.1.0",
  "connector_id": "https://registry.pdpp.org/connectors/shopify",
  "connector_key": "shopify",
  "manifest_uri": "https://registry.pdpp.org/connectors/shopify",
  "version": "0.1.0",
  "display_name": "Shopify Shop",
  "icon": {
    "kind": "inline_svg",
    "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 27\"><path d=\"M9.04738 0C5.92722 0 3.00481 0.971665 0.906387 2.37332C0.763562 2.46825 0.714122 2.6637 0.802014 2.81448L3.3344 7.20931C3.42779 7.36567 3.62554 7.42151 3.77935 7.32658C5.3724 6.34933 7.19615 5.84116 9.05837 5.85233C14.0737 5.85233 17.7597 9.4486 17.7597 14.2008C17.7597 18.2494 14.8098 21.2482 11.0689 21.2482C8.02014 21.2482 5.90524 19.4445 5.90524 16.898C5.90524 15.4405 6.51499 14.2455 8.10254 13.4023C8.26734 13.3129 8.32776 13.1063 8.22888 12.9444L5.83932 8.83433C5.76242 8.70031 5.59762 8.63888 5.4493 8.69473C2.24674 9.90093 0 12.8048 0 16.7026C0 22.5996 4.61982 27 11.0634 27C18.5892 27 24 21.7005 24 14.1003C24 5.95284 17.7047 0 9.04738 0Z\" fill=\"#5433EB\" /></svg>",
    "color": "#95BF47"
  },
  "runtime_requirements": {
    "bindings": {
      "network": {
        "required": true
      },
      "browser": {
        "required": true
      }
    }
  },
  "capabilities": {
    "human_interaction": ["manual_action"],
    "refresh_policy": {
      "recommended_mode": "manual",
      "minimum_interval_seconds": 3600,
      "interaction_posture": "manual_action_likely",
      "rate_limit_sensitivity": "medium",
      "bot_detection_sensitivity": "high",
      "background_safe": false,
      "rationale": "Shopify Shop order history requires a logged-in browser session; refresh manually."
    },
    "public_listing": {
      "tier": "development"
    }
  },
  "streams": [
    {
      "name": "orders",
      "description": "Orders placed across merchants via the Shop app.",
      "display": {
        "label": "Your Shop app orders",
        "detail": "Order date, merchant, items, prices, shipping status, tracking numbers, payment summary."
      },
      "semantics": "mutable_state",
      "schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "order_date": {
            "type": ["string", "null"],
            "format": "date-time",
            "x_pdpp_role": "event-time"
          },
          "merchant_name": {
            "type": ["string", "null"],
            "x_pdpp_role": "primary-title"
          },
          "status": {
            "type": ["string", "null"]
          },
          "total_cents": {
            "type": ["integer", "null"]
          },
          "currency": {
            "type": ["string", "null"]
          },
          "tracking_number": {
            "type": ["string", "null"]
          },
          "tracking_url": {
            "type": ["string", "null"]
          },
          "item_count": {
            "type": ["integer", "null"]
          }
        },
        "required": ["id"]
      },
      "primary_key": ["id"],
      "cursor_field": "order_date",
      "consent_time_field": "order_date",
      "selection": {
        "fields": true,
        "resources": true
      },
      "incremental": true,
      "query": {
        "search": {
          "lexical_fields": ["merchant_name"]
        },
        "range_filters": {
          "order_date": ["gte", "gt", "lte", "lt"]
        },
        "aggregations": {
          "count": true,
          "group_by_time": ["order_date"],
          "group_by": ["status", "currency"]
        }
      },
      "coverage_strategy": "checkpoint_window",
      "freshness_strategy": "manual_as_of"
    }
  ],
  "reason_display_messages": {
    "shopify_apollo_wiring_pending": "Shopify support isn't wired up yet"
  }
}
