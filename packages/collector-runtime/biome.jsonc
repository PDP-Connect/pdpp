{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": ["ultracite/biome/core", "ultracite/biome/type-aware"],
  "linter": {
    "rules": {
      "correctness": {
        // `node:sqlite` (stable Node core module since Node 22.5) is not yet
        // in Biome's built-in-module allowlist — the same documented,
        // pre-existing gap as `@pdpp/polyfill-connectors`'s biome.jsonc
        // (upstream: https://github.com/biomejs/biome/issues/9143 covers the
        // sibling package.json exports-resolution cause; this package hits
        // only the node:sqlite half, in local-device-outbox.ts and its test).
        // `tsc --noEmit` resolves it cleanly. Re-enable when Biome ships a
        // fix.
        "noUnresolvedImports": "off"
      },
      "suspicious": {
        // Package-wide policy, carried over from `@pdpp/polyfill-connectors`'s
        // biome.jsonc verbatim. This package's only baseline finding — one
        // site in collector-runner.ts (`projection.state && typeof
        // projection.state === "object"` against a non-optional field) — was
        // already individually audited there as a genuine Biome 2.5.5 false
        // positive: `tsc --noEmit` agrees the value is nullable under
        // `noUncheckedIndexedAccess`; Biome's own docs mark
        // noUnnecessaryConditions "work in progress". Behavior-preserving
        // move: this code did not change, only its package. Expiry:
        // `pnpm run check:noUnnecessaryConditions-expiry` (wired into `pnpm
        // verify`) re-runs the minimal repro against whatever Biome version
        // is installed and fails loudly the moment Biome stops reproducing
        // it — that is the re-enable signal.
        "noUnnecessaryConditions": "off"
      }
    }
  },
  "formatter": {
    "lineWidth": 120
  },
  "overrides": [
    {
      // Public barrel. `src/index.ts` is the load-bearing entry for this
      // package — it exists specifically to give consumers a single import
      // path. The noBarrelFile perf concern (large module graphs of unused
      // modules) does not apply: every module re-exported here is part of
      // the published runtime surface, and the file is intentionally narrow.
      "includes": ["src/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      // Carried over from `@pdpp/polyfill-connectors`'s biome.jsonc, whose
      // audited rationale covers this package's collector-runner.ts drain
      // loops verbatim (retry/backoff loops, lease-guarded outbox draining —
      // each attempt's outcome gates the next, so the loop is inherently
      // sequential, not an incidental style choice). Behavior-preserving
      // move: this code did not change, only its package.
      "includes": ["src/**/*.ts", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noAwaitInLoops": "off"
          }
        }
      }
    },
    {
      // Test-file override, carried over from `@pdpp/polyfill-connectors`'s
      // biome.jsonc: test bodies routinely use inline
      // /^\d{3}-.../-style regex literals for `assert.match` calls; perf is
      // irrelevant in a test runner, and hoisting them would separate the
      // pattern from the single call site it documents.
      "includes": ["**/*.test.ts"],
      "linter": {
        "rules": {
          "performance": {
            "useTopLevelRegex": "off"
          }
        }
      }
    }
  ]
}
