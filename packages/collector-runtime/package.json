{
  "name": "@pdpp/collector-runtime",
  "version": "0.0.1",
  "private": true,
  "description": "Generic connector-execution runtime for PDPP local (device-side) collection: the collector loop, device-exporter ingest client, durable outbox, and runtime-capabilities placement gate. Depends on @pdpp/connector-protocol for the connector authoring contract (wire-protocol types, JSONL primitives). Connector-agnostic — carries no connector definitions or content.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./collector-build-info": "./src/collector-build-info.ts",
    "./collector-runner": "./src/collector-runner.ts",
    "./local-device-client": "./src/local-device-client.ts",
    "./local-device-envelope": "./src/local-device-envelope.ts"
  },
  "scripts": {
    "build": "node --experimental-strip-types scripts/build.ts",
    "check": "ultracite check",
    "check:noUnnecessaryConditions-expiry": "node ./scripts/check-no-unnecessary-conditions-expiry.ts",
    "fix": "ultracite fix",
    "prepack": "pnpm build",
    "prepare": "pnpm build",
    "test": "node --import tsx ../../scripts/test-scratch/run-command.ts -- node --test --import tsx --test-concurrency=2 --test-timeout=120000 \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm check && pnpm check:noUnnecessaryConditions-expiry && pnpm test"
  },
  "dependencies": {
    "@pdpp/connector-protocol": "workspace:*",
    "@pdpp/reference-contract": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "ultracite": "7.10.2"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./collector-build-info": {
        "types": "./dist/collector-build-info.d.ts",
        "import": "./dist/collector-build-info.js"
      },
      "./collector-runner": {
        "types": "./dist/collector-runner.d.ts",
        "import": "./dist/collector-runner.js"
      },
      "./local-device-client": {
        "types": "./dist/local-device-client.d.ts",
        "import": "./dist/local-device-client.js"
      },
      "./local-device-envelope": {
        "types": "./dist/local-device-envelope.d.ts",
        "import": "./dist/local-device-envelope.js"
      }
    }
  }
}
