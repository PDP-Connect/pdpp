{
  "name": "@pdpp/connector-protocol",
  "version": "0.0.1",
  "private": true,
  "description": "The connector authoring contract for PDPP: the JSONL wire-protocol message types, the LocalCollectorDefinition type contract, the bootstrap/emit/scope-filter primitives connector authors import directly, and small text/auth/retry utilities connectors depend on. Bottom of the dependency graph — depends on nothing in @pdpp/collector-runtime or @pdpp/polyfill-connectors, so connector authors never pull in the runtime package or its release cadence just to get the files they author against.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth.ts",
    "./collector-definition": "./src/collector-definition.ts",
    "./connector-runtime-protocol": "./src/connector-runtime-protocol.ts",
    "./http-retry": "./src/http-retry.ts",
    "./pdpp-safe-text": "./src/pdpp-safe-text.ts",
    "./safe-text-preview": "./src/safe-text-preview.ts"
  },
  "scripts": {
    "build": "node --experimental-strip-types scripts/build.ts",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepack": "pnpm build",
    "prepare": "pnpm build",
    "test": "node --import tsx ../../scripts/test-scratch/run-command.ts -- node --test --import tsx --test-concurrency=2 --test-timeout=120000 \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm check && pnpm test"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "ultracite": "7.10.2"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./auth": {
        "types": "./dist/auth.d.ts",
        "import": "./dist/auth.js"
      },
      "./collector-definition": {
        "types": "./dist/collector-definition.d.ts",
        "import": "./dist/collector-definition.js"
      },
      "./connector-runtime-protocol": {
        "types": "./dist/connector-runtime-protocol.d.ts",
        "import": "./dist/connector-runtime-protocol.js"
      },
      "./http-retry": {
        "types": "./dist/http-retry.d.ts",
        "import": "./dist/http-retry.js"
      },
      "./pdpp-safe-text": {
        "types": "./dist/pdpp-safe-text.d.ts",
        "import": "./dist/pdpp-safe-text.js"
      },
      "./safe-text-preview": {
        "types": "./dist/safe-text-preview.d.ts",
        "import": "./dist/safe-text-preview.js"
      }
    }
  }
}
