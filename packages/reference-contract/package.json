{
  "name": "@pdpp/reference-contract",
  "version": "0.1.0",
  "private": true,
  "description": "JSON-Schema-first route manifests, validators, OpenAPI artifacts, and typed helpers for the PDPP reference implementation.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./common": "./src/common/index.ts",
    "./public": "./src/public/index.ts",
    "./public/source": "./src/public/source.ts",
    "./reference": "./src/reference/index.ts",
    "./builders": "./src/builders/index.ts",
    "./evidence": "./src/evidence/index.ts",
    "./openapi": "./src/openapi/index.ts",
    "./validate": "./src/validate.ts"
  },
  "main": "./src/index.ts",
  "scripts": {
    "check": "ultracite check",
    "check:generated": "pnpm run generate:all && node ./scripts/check-generated.ts",
    "fix": "ultracite fix",
    "generate:all": "node ./src/openapi/generate.ts && node ./src/docs/generate.ts",
    "generate:docs": "node ./src/docs/generate.ts",
    "generate:openapi": "node ./src/openapi/generate.ts",
    "test": "node --import tsx ../../scripts/test-scratch/run-command.ts -- node ../../scripts/run-node-tests.mjs --test --import tsx \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm check && pnpm test"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "ultracite": "7.10.7"
  }
}
