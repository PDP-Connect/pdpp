{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": ["ultracite/biome/core", "ultracite/biome/type-aware"],
  "formatter": {
    "lineWidth": 120
  },
  // Object insertion order is observable through Object.keys, for-in, and
  // JSON.stringify. Keep authored query/serialization order; this disables
  // only Biome's source assist, not a linter rule.
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "off"
      }
    }
  },
  "files": {
    "ignoreUnknown": true,
    // The tracked-source contract includes authored JS/TS/config files;
    // generated, build, raw data, and report artifacts are force-excluded;
    // legacy JS is intentionally not renamed here.
    "includes": [
      "!!**/node_modules",
      "!!**/.git",
      "!!**/dist",
      "!!**/build",
      "!!**/out",
      "!!**/.next",
      "!!**/.source",
      "!!**/coverage",
      "!!**/reports",
      "!!**/report",
      "!!**/*.snap",
      "!!**/*.har",
      "!!**/*.jsonl",
      "!!**/docs/generated",
      "!!**/next-env.d.ts",
      "!!**/report.*.json"
    ]
  }
}
