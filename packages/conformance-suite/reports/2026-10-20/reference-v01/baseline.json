    {
      "caseId": "AS-15/rendered-client-claims-bound-with-attribution",
      "detail": "The staged artifact carries no client_claims, so this deployment does not render them on the final review surface and clause 6.3-2's condition is not met. A target that renders claims binds them here.",
      "owner": "PDP-Connect/pdpp",
      "targetOwner": "PDP-Connect/data-connect"
    },
    {
      "caseId": "AS-16/provider-native-source-id-mismatch-refused",
      "detail": "The adapter has no submitDeclaration hook, so what this AS accepts as a source declaration cannot be observed. Closing this needs a target that can be offered a declaration without approving anything.",
