{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    // Ultracite's useImportExtensions rule requires explicit extensions
    // on local imports; Next.js / tsx strip them at load time.
    "allowImportingTsExtensions": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // fumadocs-mdx writes into PDPP_SITE_SOURCE_DIR (default ".source"; see
    // scripts/site-runtime.ts), isolated per run mode so dev, verify, and
    // build never clobber each other's generated output (see next.config.ts's
    // matching webpack/turbopack aliases). tsc has no env-var substitution in
    // "paths", so list every mode's directory; tsc resolves the first one that
    // exists.
    "paths": {
      "@/*": ["./src/*"],
      "@generated-docs/*": [
        "./.source/*",
        "./.source-verify/*",
        "./.source-dev/*"
      ],
      "collections/*": ["./.source/*", "./.source-verify/*", "./.source-dev/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "../../packages/pdpp-brand-react/src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-*/types/**/*.ts",
    ".next-*/dev/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-dev/dev/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-verify/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
