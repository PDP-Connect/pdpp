{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    // Ultracite's useImportExtensions rule requires explicit extensions
    // on local imports; Next.js / tsx strip them at load time.
    "allowImportingTsExtensions": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // fumadocs-mdx writes into PDPP_SITE_SOURCE_DIR (default ".source"; see
    // scripts/site-runtime.ts), isolated per run mode so dev, verify, and
    // build never clobber each other's generated output (see
    // next.config.mjs's matching webpack/turbopack aliases and its
    // typescript.tsconfigPath, which points next build's own internal
    // type-check at the right tsconfig for the same reason this file exists).
    // tsc has no env-var substitution in "paths", so this default config
    // resolves only ".source" — the editor/IDE and a plain `types:check` (no
    // PDPP_SITE_SOURCE_DIR set) both use that directory. A mode that isolates
    // its output elsewhere (currently just "verify", via .source-verify)
    // needs its own tsconfig with "paths" pointed at that directory instead
    // of a fallback list here: listing every mode's directory would let tsc
    // silently resolve a stale leftover directory ahead of the one the
    // current run actually generated, masking a real type error in fresh
    // output. See tsconfig.verify.json.
    "paths": {
      "@/*": ["./src/*"],
      "@generated-docs/*": ["./.source/*"],
      "collections/*": ["./.source/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "../../packages/pdpp-brand-react/src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-*/types/**/*.ts",
    ".next-*/dev/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-dev/dev/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-verify/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
