{
  "name": "pdpp",
  "version": "1.0.0",
  "private": true,
  "description": "PDPP protocol specs, docs site, and design workbench.",
  "keywords": [],
  "license": "Apache-2.0",
  "author": "",
  "type": "module",
  "scripts": {
    "//site:dev": "Public docs/marketing surface (apps/site): home, docs, reference, llms*, sandbox (mock-backed), planning, design, palette. No BFF, no live AS/RS. Defaults to :3001.",
    "agent-skill:boundary-check": "pnpm test:scratch -- node --test --import tsx scripts/agent-skill-boundary.test.ts",
    "agent-skill:check": "node --import tsx scripts/sync-agent-skill.ts --check",
    "agent-skill:sync": "node --import tsx scripts/sync-agent-skill.ts --write",
    "biome:policy": "node --import tsx scripts/biome-policy-receipt.ts",
    "biome:policy:write": "node --import tsx scripts/biome-policy-receipt.ts --write-ledger",
    "biome:selection": "node --import tsx scripts/check-biome-file-selection.ts",
    "ci:mode:hosted": "node --import tsx scripts/ci-mode.ts hosted",
    "ci:mode:local": "node --import tsx scripts/ci-mode.ts local",
    "ci:mode:status": "node --import tsx scripts/ci-mode.ts status",
    "ci:mode:test": "pnpm test:scratch -- node --test --import tsx scripts/ci-mode.test.ts",
    "ci:signoff": "node --import tsx scripts/ci-mode.ts signoff",
    "generated-artifacts:check": "node --import tsx scripts/check-generated-artifacts.ts",
    "generated-artifacts:write": "node --import tsx scripts/check-generated-artifacts.ts --write",
    "openspec:archive-check": "node --import tsx scripts/openspec-archive-check.ts",
    "openspec:archive-check:test": "pnpm test:scratch -- node --test --import tsx scripts/openspec-archive-check.test.ts",
    "public-tree:hygiene-check": "node --import tsx scripts/check-public-tree-hygiene.ts",
    "public-tree:hygiene-check:test": "pnpm test:scratch -- node --test --import tsx scripts/check-public-tree-hygiene.test.ts",
    "read-surface:smoke": "pnpm test:scratch -- node --import tsx scripts/read-surface-smoke.ts",
    "read-surface:smoke:test": "pnpm test:scratch -- node --test --import tsx scripts/read-surface-smoke.test.ts",
    "reference-contract:check-generated": "pnpm --filter @pdpp/reference-contract run check:generated",
    "release": "semantic-release",
    "release:dist-tag-check": "node --import tsx scripts/check-dist-tag-posture.ts",
    "release:dist-tag-check:test": "pnpm test:scratch -- node --test --import tsx scripts/check-dist-tag-posture.test.ts",
    "release:dry-run": "semantic-release --dry-run --no-ci",
    "release:local": "pnpm release:policy-check",
    "release:policy-check": "node --import tsx scripts/check-package-release-policy.ts",
    "release:policy-check:test": "pnpm test:scratch -- node --test --import tsx scripts/check-package-release-policy.test.ts",
    "release:signoff": "pnpm release:local && pnpm release:dry-run",
    "retained-js-mjs:check": "node --import tsx scripts/check-retained-js-mjs-boundaries.ts",
    "site:build": "pnpm --dir apps/site build",
    "site:dev": "pnpm --dir apps/site dev",
    "site:start": "pnpm --dir apps/site start",
    "spec:check": "node --import tsx scripts/spec-check.ts",
    "spec:dates": "node --import tsx scripts/spec-date-check.ts",
    "spec:dates:write": "node --import tsx scripts/spec-date-check.ts --write",
    "spec:owner-filter-check": "node --import tsx scripts/check-owner-filter-grant-coupling.ts",
    "spec:owner-filter-check:test": "pnpm test:scratch -- node --test --import tsx scripts/check-owner-filter-grant-coupling.test.ts",
    "spec:prose": "node scripts/spec-prose-lint.mjs",
    "spec:prose:fix": "node scripts/spec-prose-lint.mjs --fix",
    "spec:prose:test": "pnpm test:scratch -- node --test scripts/spec-prose-lint.test.mjs",
    "stream:parity:calibrate": "node --import tsx scripts/stream-playground-parity-calibration.ts",
    "stream-debug:summary": "node --import tsx scripts/stream-debug-summary.ts",
    "stream-health:audit": "node --import tsx scripts/check-stream-health-audit.ts",
    "test:scratch": "node --import tsx scripts/test-scratch/run-command.ts",
    "test-accounting:check": "pnpm test:scratch -- node scripts/test-accounting/with-local-full-suite-lock.mjs node --import tsx scripts/test-accounting/authority.ts --run --suite all",
    "test-accounting:inventory": "node --import tsx scripts/test-accounting/inventory.ts --check --fail-on-unaccounted --fail-on-empty",
    "test-accounting:test": "pnpm test:scratch -- node scripts/run-node-tests.mjs --test --import tsx scripts/test-accounting/*.test.ts"
  },
  "devDependencies": {
    "@babel/parser": "8.0.6",
    "@biomejs/biome": "2.5.14",
    "@pdpp/brand": "workspace:*",
    "@pdpp/list-envelope": "workspace:*",
    "@semantic-release/exec": "^7.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "lefthook": "^2.1.14",
    "patchright": "1.63.0",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "ultracite": "7.12.0"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.15.0"
  }
}
