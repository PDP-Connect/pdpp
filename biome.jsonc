{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "extends": ["ultracite/biome/core", "ultracite/biome/type-aware"],
  "formatter": {
    "lineWidth": 120
  },
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "off"
      }
    }
  },
  "files": {
    "ignoreUnknown": true,
    // The tracked-source contract starts with all files Biome recognizes.
    // Force-ignore patterns exclude dependency/build output, raw data, and
    // generated/report artifacts; authored JS and executable fixtures remain.
    "includes": [
      "!!**/node_modules",
      "!!**/.git",
      "!!**/dist",
      "!!**/build",
      "!!**/out",
      "!!**/.next",
      "!!**/.source",
      "!!**/coverage",
      "!!**/reports",
      "!!**/report",
      "!!**/*.snap",
      "!!**/*.har",
      "!!**/*.jsonl",
      "!!**/docs/generated",
      "!!packages/polyfill-connectors/fixtures/**/*.json",
      "!!packages/polyfill-connectors/fixtures/**/*.html",
      "!!packages/polyfill-connectors/fixtures/**/*.csv",
      "!!packages/polyfill-connectors/fixtures/**/*.md",
      "!!packages/polyfill-connectors/fixtures/**/*.log",
      "!!packages/polyfill-connectors/fixtures/**/*.dat",
      "!!packages/polyfill-connectors/connectors/**/__fixtures__/**/*.html",
      "!!packages/polyfill-connectors/connectors/**/__fixtures__/**/*.json",
      "!!packages/polyfill-connectors/connectors/**/__fixtures__/**/*.csv",
      // Twitter archive exports are provider-captured JavaScript data, not
      // executable fixture helpers. Keep the archive subtree byte-faithful.
      "!!packages/polyfill-connectors/connectors/twitter_archive/__fixtures__/archive-files/**/*.js",
      "!!reference-implementation/test/fixtures/*.json",
      "!!**/next-env.d.ts",
      "!!**/report.*.json"
    ]
  },
  "overrides": [
    {
      // Remote-surface was previously outside the workspace check set, so
      // `pnpm --filter @opendatalabs/remote-surface check` was a false green. Keep
      // the package under Biome analysis now, but waive the pre-existing
      // Ultracite migration debt that surfaced when the files became visible.
      //
      // This is intentionally scoped to packages/remote-surface/src/**/*.ts:
      // new syntax/configuration problems and any non-waived Ultracite rules
      // still fail the package check, while style/assist cleanup can land in a
      // separate product-code-only tranche.
      "includes": ["packages/remote-surface/src/**/*.ts"],
      "formatter": {
        "enabled": false
      },
      "assist": {
        "actions": {
          "source": {
            "organizeImports": "off",
            "useSortedInterfaceMembers": "off"
          }
        }
      },
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noUselessUndefined": "off",
            "noVoid": "off",
            "useSimplifiedLogicExpression": "off"
          },
          "correctness": {
            "noUnresolvedImports": "off"
          },
          "performance": {
            "noBarrelFile": "off"
          },
          "style": {
            "useBlockStatements": "off",
            "useConsistentTypeDefinitions": "off",
            "useExportType": "off",
            "useNumericSeparators": "off"
          },
          "suspicious": {
            "useAwait": "off"
          }
        }
      }
    },
    {
      // Connector-specific override. As of 2026-04-22 only
      // noExcessiveCognitiveComplexity is relaxed here — all other migration
      // escape valves (useTopLevelRegex, noNestedTernary, noAssignInExpressions,
      // noBitwiseOperators, noImplicitAnyLet, noEvolvingTypes, useTemplate)
      // have been eliminated and their violations fixed in-place.
      //
      // 30 connector functions exceed the default cognitive-complexity budget
      // of 20 (range 21–255). They fall into three buckets that cannot be
      // cleanly decomposed:
      //   (a) page.evaluate(() => {...}) callbacks (chase enumerate,
      //       chatgpt auth, usaa diagnostics, etc.). The callback body is
      //       serialized and shipped to the browser — helpers defined in
      //       Node cannot cross the bridge, so decomposition forces either
      //       duplicated inline helpers or contorted parameter threading.
      //   (b) collect() orchestrators that own cursor lifetime, emit
      //       ordering, dedup keys, and multi-stream coordination
      //       (chatgpt c=199, gmail c=220, slack c=255, usaa c=236).
      //       Breaking these fragments invariants that must hold together
      //       ("emit RECORD before advance cursor", "normalize → shape-check
      //       → emit → state-advance per item").
      //   (c) Tree/DOM walkers and loosely-typed parsers (chase QFX-tree
      //       extraction, codex walkRollouts generator, ical VEVENT line
      //       parser). Their branching mirrors the external format.
      // Re-enable per file after the connector moves to the
      // makeEmitRecord + named stream-helper pattern (see
      // src/connector-runtime.ts).
      "includes": ["connectors/**/*.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      // @pdpp/mcp-server TypeScript migration (2026-07-25). Two rules are
      // confirmed Biome-resolver false positives here, not real debt:
      //
      // - noUnresolvedImports: fires on `@modelcontextprotocol/sdk/server/*.js`
      //   subpath imports. Both `tsc` and `node --input-type=module -e
      //   "import.meta.resolve(...)"` resolve these correctly through the
      //   SDK's package.json `exports` map; Biome's resolver does not walk
      //   pnpm's nested node_modules layout for scoped-package subpath
      //   exports. No other package in the workspace imports this SDK yet,
      //   so this is the first time the gap has surfaced.
      // - noBarrelFile: `server.ts`/`index.ts` each have exactly one
      //   deliberate `export { X } from './y.js'` line re-exporting a
      //   downstream module's public symbol at the package's public
      //   boundary (not a full barrel re-export of a directory) — the same
      //   pattern the MCP SDK and this package's own public API already
      //   rely on for `@pdpp/mcp-server` and `@pdpp/mcp-server/server`.
      "includes": ["packages/mcp-server/src/server.ts", "packages/mcp-server/src/index.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off"
          },
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    }
  ]
}
