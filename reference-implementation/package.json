{
  "name": "pdpp-reference-implementation",
  "version": "0.1.0",
  "private": true,
  "description": "Forkable PDPP reference implementation with AS/RS, runtime, CLI, and conformance-style tests.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./reference-local-defaults": "./server/reference-local-defaults.ts",
    "./reference-topology": "./server/reference-topology.ts",
    "./connection-setup-plan": "./server/connection-setup-plan.ts",
    "./owner-session": "./server/owner-session.ts",
    "./deployment-diagnostics": "./server/deployment-diagnostics.ts",
    "./manual-upload-limits": "./server/manual-upload-limits.ts",
    "./operations/as-authorization-server-metadata": "./operations/as-authorization-server-metadata/index.ts",
    "./operations/ref-spine-correlations-list": "./operations/ref-spine-correlations-list/index.ts",
    "./operations/ref-spine-events-page": "./operations/ref-spine-events-page/index.ts",
    "./operations/rs-streams-list": "./operations/rs-streams-list/index.ts",
    "./operations/rs-streams-detail": "./operations/rs-streams-detail/index.ts",
    "./operations/rs-schema-get": "./operations/rs-schema-get/index.ts",
    "./operations/rs-records-list": "./operations/rs-records-list/index.ts",
    "./operations/rs-records-detail": "./operations/rs-records-detail/index.ts",
    "./operations/rs-search-lexical": "./operations/rs-search-lexical/index.ts",
    "./operations/rs-search-semantic": "./operations/rs-search-semantic/index.ts",
    "./operations/rs-search-hybrid": "./operations/rs-search-hybrid/index.ts",
    "./operations/rs-blobs-upload": "./operations/rs-blobs-upload/index.ts",
    "./operations/rs-blobs-read": "./operations/rs-blobs-read/index.ts",
    "./operations/rs-records-delete-stream": "./operations/rs-records-delete-stream/index.ts",
    "./operations/rs-records-delete": "./operations/rs-records-delete/index.ts",
    "./operations/rs-records-ingest": "./operations/rs-records-ingest/index.ts",
    "./operations/rs-protected-resource-metadata": "./operations/rs-protected-resource-metadata/index.ts",
    "./operations/ref-dataset-summary": "./operations/ref-dataset-summary/index.ts"
  },
  "bin": {
    "pdpp": "./cli/index.ts"
  },
  "scripts": {
    "//dev": "Default dev is quiet again. Use `pnpm dev:trace-gc` only when investigating native/V8 crash behavior under load. Diagnostic reports go to ../tmp/node-reports/ and exclude env/network sections so connector credentials are not persisted.",
    "check": "ultracite check",
    "check:seam:pr89:receipt": "node --import tsx ../scripts/test-scratch/run-command.ts -- node --import tsx scripts/check-pr89-seam-receipt.ts",
    "cli": "node cli/index.ts",
    "dev": "sh -c 'mkdir -p ../tmp/node-reports && node --env-file-if-exists=../.env.local --import ./server/dev-env-defaults.ts --report-on-fatalerror --report-uncaught-exception --report-exclude-env --report-exclude-network --report-directory=../tmp/node-reports server/index.ts'",
    "dev:trace-gc": "sh -c 'mkdir -p ../tmp/node-reports && node --env-file-if-exists=../.env.local --import ./server/dev-env-defaults.ts --report-on-fatalerror --report-uncaught-exception --report-exclude-env --report-exclude-network --report-directory=../tmp/node-reports --trace-gc --trace-gc-verbose server/index.ts'",
    "example-client": "node examples/third-party-app/server.ts",
    "fix": "ultracite fix",
    "generate:connector-registry": "node --experimental-strip-types scripts/generate-connector-registry.ts",
    "server": "sh -c 'PDPP_REFERENCE_OPERATIONAL_DEFAULTS=${PDPP_REFERENCE_OPERATIONAL_DEFAULTS:-1} node --env-file-if-exists=../.env.local server/index.ts'",
    "test": "node --import tsx ../scripts/test-scratch/run-command.ts -- node scripts/run-tests.ts",
    "test:live-cdp": "PDPP_TEST_LIVE_CDP=1 node --import tsx ../scripts/test-scratch/run-command.ts -- node --test test/run-interaction-stream-cdp-live.test.ts",
    "test:live-neko": "PDPP_TEST_LIVE_NEKO=1 node --import tsx ../scripts/test-scratch/run-command.ts -- node --test --import tsx test/run-interaction-stream-neko-live.test.ts",
    "test:manual-upload-no-whole-file-read": "node --import tsx ../scripts/test-scratch/run-command.ts -- node --experimental-test-module-mocks --expose-gc --test --import tsx test/manual-upload-whatsapp-no-whole-file-read.test.ts",
    "test:run-generation-fencing-terminal-write-failure": "node --import tsx ../scripts/test-scratch/run-command.ts -- node --experimental-test-module-mocks --test --import tsx test/run-generation-fencing-terminal-write-failure.test.ts",
    "test:seam:pr89": "node --import tsx ../scripts/test-scratch/run-command.ts -- node --import tsx scripts/run-pr89-seam.ts",
    "test:seam:pr89:receipt": "node --import tsx ../scripts/test-scratch/run-command.ts -- node --test --import tsx scripts/check-pr89-seam-receipt.test.ts",
    "test:semantic-multilingual-smoke": "PDPP_MULTILINGUAL_MINILM_SMOKE=1 node --import tsx ../scripts/test-scratch/run-command.ts -- node --test --test-timeout=240000 --test-name-pattern \"multilingual-minilm profile\" test/semantic-retrieval.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm check"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@huggingface/transformers": "^4.2.0",
    "@pdpp/collector-runtime": "file:../vendor/pdpp-collector-runtime-0.0.1.tgz",
    "@pdpp/connector-protocol": "file:../vendor/pdpp-connector-protocol-0.0.1.tgz",
    "@pdpp/mcp-server": "workspace:*",
    "@pdpp/reference-contract": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "fastify": "^5.12.0",
    "ipaddr.js": "2.5.0",
    "patchright": "1.61.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "qs": "^6.15.3",
    "sqlite-vec": "^0.1.9",
    "undici": "^8.10.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@babel/parser": "7.29.2",
    "@biomejs/biome": "2.5.8",
    "@types/pg": "8.21.0",
    "jsdom": "^30.0.1",
    "pino-pretty": "^13.0.0",
    "ultracite": "7.10.5"
  },
  "optionalDependencies": {
    "@opendatalabs/remote-surface": "^1.5.2"
  }
}
