{
  "$schema": "../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": ["ultracite/biome/core", "ultracite/biome/type-aware"],
  "formatter": {
    "lineWidth": 120
  },
  "files": {
    "ignoreUnknown": true,
    // The tracked-source contract includes authored JS/TS/config files;
    // generated, build, raw data, and report artifacts are force-excluded.
    // Legacy JS and executable runtime fixtures remain in scope.
    "includes": [
      "!!**/node_modules",
      "!!**/.git",
      "!!**/dist",
      "!!**/build",
      "!!**/out",
      "!!**/.next",
      "!!**/.source",
      "!!**/coverage",
      "!!**/reports",
      "!!**/report",
      "!!**/*.snap",
      "!!**/*.har",
      "!!**/*.jsonl",
      "!!docs/generated",
      // OpenAPI JSON is canonical generator output and is byte-checked by
      // reference-contract:check-generated. Keep it out of formatter input;
      // reference-full.openapi.json also exceeds Biome's source-size ceiling.
      "!!openapi",
      "!!test/fixtures/*.json",
      "!!**/next-env.d.ts",
      "!!**/report.*.json"
    ]
  },
  "linter": {
    "rules": {
      "style": {
        // Closed TypeScript unions should handle every case explicitly without
        // a redundant default. Open-ended switches over strings/numbers still
        // use default branches in code.
        "useDefaultSwitchClause": "off"
      },
      "nursery": {
        "useExhaustiveSwitchCases": "error"
      }
    }
  },
  "overrides": [
    {
      // server/records.ts TypeScript migration (2026-07-27). Line 120 is a
      // deliberate single re-export (`export { resolveRecordIdentityForBinding }
      // from "./connection-identity.ts"`) at the server package boundary — not
      // a barrel re-export of a directory. Same class as the mcp-server override
      // in the root biome.jsonc.
      "includes": ["server/records.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      // server/local-transformer-child.ts (Lane C3c TypeScript migration,
      // 2026-07-26). Same confirmed resolver-gap class as the
      // packages/mcp-server SDK/tsx overrides in the root biome.jsonc, not
      // real debt: `@huggingface/transformers` ships a package.json
      // `exports` map (dist/transformers.node.mjs) that both
      // `npx tsc --noEmit -p tsconfig.json` and
      // `node --input-type=module -e
      // "console.log(import.meta.resolve('@huggingface/transformers'))"`
      // resolve cleanly; Biome's resolver reports "found directory without
      // index" for this package's dist layout instead. `useAwait` is also
      // disabled here: the `async ({ env, LogLevel, pipeline }) => {...}`
      // callback passed to the dynamic `import(...)`'s `.then(...)`
      // predates this migration (byte-identical logic to the original
      // `.js`, only newly typed) and returns the `pipeline(...)` call's own
      // Promise without an internal `await`; preserved as-is rather than
      // refactored during a type-only migration.
      "includes": ["server/local-transformer-child.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off"
          },
          "suspicious": {
            "useAwait": "off"
          }
        }
      }
    }
  ]
}
