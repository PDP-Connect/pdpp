{
  "name": "@pdpp/cli",
  "version": "0.0.0",
  "description": "Command-line tools for PDPP providers.",
  "type": "module",
  "bin": {
    "pdpp": "./dist/bin/pdpp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./cache-layout": {
      "types": "./dist/src/cache-layout.d.ts",
      "import": "./dist/src/cache-layout.js"
    },
    "./package-info": {
      "types": "./dist/src/package-info.d.ts",
      "import": "./dist/src/package-info.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && node --import tsx scripts/generate-list-envelope.ts && tsc -p tsconfig.build.json && node --import tsx scripts/postbuild.ts",
    "prepare": "pnpm build",
    "prepack": "pnpm build",
    "test": "pnpm build && node --import tsx scripts/run-tests.ts",
    "validate:package": "pnpm build && node --import tsx scripts/validate-package.ts",
    "pack-install-run": "pnpm build && node --import tsx scripts/pack-install-run.ts",
    "pack-install-run:node-22.14": "node --import tsx scripts/verify-node-22-14-artifact.ts",
    "verify": "pnpm test && pnpm validate:package && pnpm pack-install-run",
    "pack:dry-run": "pnpm build && npm pack --dry-run --ignore-scripts"
  },
  "keywords": [
    "pdpp",
    "personal-data",
    "oauth",
    "cli"
  ],
  "devDependencies": {
    "@types/node": "^26.2.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PDP-Connect/pdpp.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/PDP-Connect/pdpp/issues"
  },
  "homepage": "https://github.com/PDP-Connect/pdpp#readme",
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false,
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  }
}
