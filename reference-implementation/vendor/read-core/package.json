{
  "name": "@pdpp/read-core",
  "version": "0.0.0",
  "type": "module",
  "description": "Pure, adapter-agnostic primitives for shaping PDPP read results into bounded previews, continuation descriptors, handle metadata, and escalation paths.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PDP-Connect/pdpp.git",
    "directory": "packages/read-core"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "node --experimental-strip-types scripts/build.ts",
    "prepare": "pnpm build",
    "prepack": "pnpm build",
    "test": "node --import tsx ../../scripts/test-scratch/run-command.ts -- node --experimental-strip-types scripts/run-tests.ts",
    "validate-package": "pnpm build && node --experimental-strip-types scripts/validate-package.ts",
    "pack-install-test": "pnpm build && node --experimental-strip-types scripts/pack-install-test.ts",
    "verify:node-22.14": "pnpm build && node --experimental-strip-types scripts/verify-node-22.14.ts",
    "verify": "pnpm test && pnpm validate-package && pnpm pack-install-test"
  },
  "keywords": [
    "pdpp",
    "personal-data",
    "read",
    "read-surface"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": false,
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "directories": {
    "test": "test"
  },
  "author": "",
  "bugs": {
    "url": "https://github.com/PDP-Connect/pdpp/issues"
  },
  "homepage": "https://github.com/PDP-Connect/pdpp#readme"
}
