{
  "access_mode": "continuous",
  "purpose_code": "https://pdpp.dev/purpose/personal_ai_assistant",
  "purpose_description": "Build a personal listening summary",
  "retention": {
    "max_duration": "P30D",
    "on_expiry": "delete"
  },
  "source": {
    "id": "https://sources.example/records/spotify",
    "kind": "connector"
  },
  "streams": [
    {
      "fields": ["id", "name", "observed_at"],
      "instance_ids": ["account-a"],
      "name": "top_artists",
      "resources": ["artist:42"],
      "time_constraint": {
        "field": "observed_at",
        "since": "2026-01-01T00:00:00Z",
        "until": "2026-04-01T00:00:00Z"
      }
    },
    {
      "fields": ["id", "played_at", "title"],
      "instance_ids": ["account-b"],
      "name": "recently_played"
    }
  ],
  "type": "https://pdpp.dev/data-access"
}
